<Window
    x:Class="SKAProject.InputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ввод данных"
    Width="400"
    Height="200"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Arian"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <Grid>
        <Border
            Background="#EDF4FF"
            BorderBrush="#6366F1"
            BorderThickness="1"
            CornerRadius="20">
            <StackPanel Margin="20">
                <TextBlock
                    x:Name="TxtPrompt"
                    Margin="0,0,0,10"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#2D3748"
                    Text="Введите значение:" />
                <TextBox
                    x:Name="TxtValue"
                    Height="35"
                    Margin="0,0,0,15"
                    FontSize="16"
                    Style="{DynamicResource TxtBoxStyle}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Width="80"
                        Height="32"
                        Margin="0,0,10,0"
                        Background="#6366F1"
                        BorderThickness="0"
                        Click="BtnOk_Click"
                        Content="ОК"
                        Cursor="Hand"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button
                        Width="80"
                        Height="32"
                        Background="#6B7280"
                        BorderThickness="0"
                        Click="BtnCancel_Click"
                        Content="Отмена"
                        Cursor="Hand"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>