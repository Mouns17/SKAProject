<Window
    x:Class="SKAProject.CreateTaskWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420"
    Height="480"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Arian"
    ResizeMode="NoResize"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    WindowStyle="None">
    <Grid MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
        <Border
            Width="420"
            Height="480"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#EDF4FF"
            BorderBrush="#6366F1"
            BorderThickness="1"
            CornerRadius="20">
            <Grid>
                <StackPanel>
                    <Button
                        Margin="375,5,0,80"
                        Click="BtnClose"
                        Content="✖︎"
                        Style="{DynamicResource ControlBtnStyle}" />

                    <TextBlock
                        Margin="0,-60,0,0"
                        HorizontalAlignment="Center"
                        FontSize="28"
                        FontWeight="Bold"
                        Text="Создание задачи" />

                    <TextBlock
                        Margin="0,-25,0,0"
                        FontSize="12"
                        Foreground="#6366F1"
                        Text="Чтобы создать задачу, заполните все поля"
                        TextAlignment="Center" />

                    <Border
                        Height="1"
                        Margin="40,0,40,0"
                        Background="{DynamicResource DividerBrush}" />

                    <!--  Название задачи  -->
                    <TextBox
                        x:Name="TBoxTitle"
                        Width="300"
                        Height="35"
                        Margin="0,15,0,10"
                        HorizontalAlignment="Center"
                        Style="{DynamicResource TxtBoxStyle}"
                        Tag="Введите название задачи" />

                    <!--  Описание  -->
                    <TextBox
                        x:Name="TBoxDescription"
                        Width="300"
                        Height="70"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        AcceptsReturn="True"
                        Style="{DynamicResource TxtBoxStyle}"
                        Tag="Введите описание"
                        TextWrapping="Wrap" />

                    <!--  Приоритет (без отдельного стиля)  -->
                    <ComboBox
                        x:Name="CmbPriority"
                        Width="300"
                        Height="35"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        Background="White"
                        BorderBrush="#6366F1"
                        FontSize="14"
                        SelectedIndex="1">
                        <ComboBoxItem Content="Низкий" />
                        <ComboBoxItem Content="Средний" />
                        <ComboBoxItem Content="Высокий" />
                    </ComboBox>

                    <!--  Срок выполнения (без отдельного стиля)  -->
                    <DatePicker
                        x:Name="DpDeadline"
                        Width="300"
                        Height="35"
                        Margin="0,0,0,15"
                        HorizontalAlignment="Center"
                        Background="White"
                        BorderBrush="#6366F1"
                        FontSize="14" />

                    <Border
                        Height="1"
                        Margin="40,0,40,0"
                        Background="{DynamicResource DividerBrush}" />

                    <Button
                        x:Name="BtnCreate"
                        Margin="50,15,50,190"
                        Click="BtnCreate_Click"
                        Content="Создать"
                        Style="{DynamicResource LogBtnStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>