<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ThemeToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="90" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <!--  Фоновая дорожка  -->
                        <Border
                            x:Name="SwitchTrack"
                            Background="{DynamicResource ThemeSwitchTrackBrush}"
                            BorderBrush="{DynamicResource ThemeSwitchBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18" />

                        <!--  Иконка Солнца (слева, означает светлую тему)  -->
                        <TextBlock
                            Margin="8,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{DynamicResource ThemeSwitchForeground}"
                            Opacity="1"
                            Text="☀️" />

                        <!--  Иконка Луны (справа, означает тёмную тему)  -->
                        <TextBlock
                            Margin="0,0,8,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{DynamicResource ThemeSwitchForeground}"
                            Opacity="1"
                            Text="🌙" />

                        <!--  Ползунок (перемещается и перекрывает иконку)  -->
                        <Ellipse
                            x:Name="Thumb"
                            Width="30"
                            Height="30"
                            Margin="3,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource ThemeSwitchThumbBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect
                                    BlurRadius="5"
                                    Opacity="0.15"
                                    ShadowDepth="1" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!--  Ползунок вправо (закрывает луну, открывает солнце)  -->
                                        <ThicknessAnimation
                                            Storyboard.TargetName="Thumb"
                                            Storyboard.TargetProperty="Margin"
                                            To="57,0,0,0"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!--  Ползунок влево  -->
                                        <ThicknessAnimation
                                            Storyboard.TargetName="Thumb"
                                            Storyboard.TargetProperty="Margin"
                                            To="3,0,0,0"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>