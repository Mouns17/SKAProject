<Page x:Class="SKAProject.Pages.OrgTasksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="OrgTasksPage"
      Background="#0A0A0A">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,30,40,50">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="0,0,0,32">
                <TextBlock Text="Задачи организации" FontSize="34" FontWeight="SemiBold" 
                           Foreground="#FFFFFF"/>
                <TextBlock Text="Управление корпоративными задачами и проектами" 
                           FontSize="14" Foreground="#888888" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Фильтры -->
            <Border Grid.Row="1" Background="#121212" CornerRadius="20" 
                    Padding="20" Margin="0,0,0,24" BorderBrush="#1E1E1E" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="10" Height="40" Width="250">
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" 
                                 Foreground="White" FontSize="13" Padding="12,0"
                                 VerticalContentAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="Placeholder" Text="🔍 Поиск задач..." 
                                                               Foreground="#666666" IsHitTestVisible="False"
                                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                                               Visibility="Collapsed"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ComboBox Width="140" Height="38" Margin="0,0,10,0">
                            <ComboBoxItem Content="Все статусы" IsSelected="True"/>
                            <ComboBoxItem Content="Активные"/>
                            <ComboBoxItem Content="Завершённые"/>
                            <ComboBoxItem Content="Просроченные"/>
                        </ComboBox>

                        <Button Background="#6366F1" Width="38" Height="38" Cursor="Hand">
                            <TextBlock Text="+" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Список задач -->
            <StackPanel Grid.Row="2" Margin="0,0,0,20">

                <!-- Задача 1 -->
                <Border Background="#121212" CornerRadius="16" Padding="20" Margin="0,0,0,12" 
                        BorderBrush="#1E1E1E" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="8" Height="50" CornerRadius="4" 
                                Background="#6366F1" Margin="0,0,15,0"/>

                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Внедрение системы мониторинга KPI" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <Border Background="#6366F1" CornerRadius="12" Padding="8,3" Margin="12,0,0,0">
                                    <TextBlock Text="Высокий приоритет" FontSize="10" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Разработать и внедрить систему мониторинга ключевых показателей эффективности" 
                                       FontSize="13" Foreground="#888888" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="📅 Срок: 01.05.2025" FontSize="12" Foreground="#666666"/>
                                <TextBlock Text="👤 Ответственный: Иванов И.И." FontSize="12" Foreground="#666666" Margin="20,0,0,0"/>
                                <TextBlock Text="📊 Прогресс: 65%" FontSize="12" Foreground="#10B981" Margin="20,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2" Width="90" Height="36" Background="#1A1A1A" 
                                Cursor="Hand" Margin="10,0,0,0"
                                BorderBrush="#2A2A2A" BorderThickness="1">
                            <TextBlock Text="Подробнее" Foreground="#6366F1" FontSize="12"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Задача 2 -->
                <Border Background="#121212" CornerRadius="16" Padding="20" Margin="0,0,0,12" 
                        BorderBrush="#1E1E1E" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="8" Height="50" CornerRadius="4" 
                                Background="#EC4899" Margin="0,0,15,0"/>

                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Аудит информационной безопасности" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <Border Background="#EC4899" CornerRadius="12" Padding="8,3" Margin="12,0,0,0">
                                    <TextBlock Text="Критический" FontSize="10" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Провести полный аудит систем безопасности компании" 
                                       FontSize="13" Foreground="#888888" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="📅 Срок: 15.04.2025" FontSize="12" Foreground="#666666"/>
                                <TextBlock Text="👤 Ответственный: Петров П.П." FontSize="12" Foreground="#666666" Margin="20,0,0,0"/>
                                <TextBlock Text="📊 Прогресс: 30%" FontSize="12" Foreground="#F59E0B" Margin="20,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2" Width="90" Height="36" Background="#1A1A1A" 
                                Cursor="Hand" Margin="10,0,0,0"
                                BorderBrush="#2A2A2A" BorderThickness="1">
                            <TextBlock Text="Подробнее" Foreground="#EC4899" FontSize="12"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Задача 3 -->
                <Border Background="#121212" CornerRadius="16" Padding="20" Margin="0,0,0,12" 
                        BorderBrush="#1E1E1E" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="8" Height="50" CornerRadius="4" 
                                Background="#10B981" Margin="0,0,15,0"/>

                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Обучение сотрудников" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <Border Background="#10B981" CornerRadius="12" Padding="8,3" Margin="12,0,0,0">
                                    <TextBlock Text="Средний" FontSize="10" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Провести курсы повышения квалификации для сотрудников отдела аналитики" 
                                       FontSize="13" Foreground="#888888" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="📅 Срок: 10.05.2025" FontSize="12" Foreground="#666666"/>
                                <TextBlock Text="👤 Ответственный: Козлова М.Д." FontSize="12" Foreground="#666666" Margin="20,0,0,0"/>
                                <TextBlock Text="📊 Прогресс: 100%" FontSize="12" Foreground="#10B981" Margin="20,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2" Width="90" Height="36" Background="#1A1A1A" 
                                Cursor="Hand" Margin="10,0,0,0"
                                BorderBrush="#2A2A2A" BorderThickness="1">
                            <TextBlock Text="Подробнее" Foreground="#10B981" FontSize="12"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Задача 4 -->
                <Border Background="#121212" CornerRadius="16" Padding="20" Margin="0,0,0,12" 
                        BorderBrush="#1E1E1E" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="8" Height="50" CornerRadius="4" 
                                Background="#F59E0B" Margin="0,0,15,0"/>

                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Оптимизация бизнес-процессов" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <Border Background="#F59E0B" CornerRadius="12" Padding="8,3" Margin="12,0,0,0">
                                    <TextBlock Text="Высокий" FontSize="10" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Анализ и оптимизация существующих бизнес-процессов компании" 
                                       FontSize="13" Foreground="#888888" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="📅 Срок: 20.06.2025" FontSize="12" Foreground="#666666"/>
                                <TextBlock Text="👤 Ответственный: Иванов И.И." FontSize="12" Foreground="#666666" Margin="20,0,0,0"/>
                                <TextBlock Text="📊 Прогресс: 15%" FontSize="12" Foreground="#F59E0B" Margin="20,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2" Width="90" Height="36" Background="#1A1A1A" 
                                Cursor="Hand" Margin="10,0,0,0"
                                BorderBrush="#2A2A2A" BorderThickness="1">
                            <TextBlock Text="Подробнее" Foreground="#F59E0B" FontSize="12"/>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Статистика -->
            <Border Grid.Row="3" Background="#121212" CornerRadius="20" Padding="20" 
                    BorderBrush="#1E1E1E" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="12" FontSize="24" FontWeight="Bold" Foreground="White" TextAlignment="Center"/>
                        <TextBlock Text="Всего задач" FontSize="12" Foreground="#888888"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="6" FontSize="24" FontWeight="Bold" Foreground="#6366F1" TextAlignment="Center"/>
                        <TextBlock Text="В работе" FontSize="12" Foreground="#888888"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="4" FontSize="24" FontWeight="Bold" Foreground="#10B981" TextAlignment="Center"/>
                        <TextBlock Text="Завершено" FontSize="12" Foreground="#888888"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock Text="2" FontSize="24" FontWeight="Bold" Foreground="#EC4899" TextAlignment="Center"/>
                        <TextBlock Text="Просрочено" FontSize="12" Foreground="#888888"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>