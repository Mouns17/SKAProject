<Page
    x:Class="SKAProject.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="1520"
    Height="1080"
    FontFamily="Arian">

    <Grid Margin="0,60,0,0">

        <Border
            Margin="-5,0,-5,15"
            Background="#EDF4FF"
            BorderBrush="{DynamicResource BackgroundColor6}"
            BorderThickness="1"
            CornerRadius="30">

            <ScrollViewer VerticalScrollBarVisibility="Hidden">

                <Grid Margin="40,30,40,50">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Заголовок  -->

                    <StackPanel Grid.Row="0" Margin="0,0,0,32">

                        <TextBlock
                            FontSize="40"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Главное меню" />

                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="30"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Общая статистика и быстрый доступ" />

                    </StackPanel>

                    <!--  Карточки статистики  -->

                    <UniformGrid
                        Grid.Row="1"
                        Margin="0,0,0,30"
                        Columns="4">

                        <Border Style="{DynamicResource ModernCard}">
                            <StackPanel>
                                <TextBlock FontSize="22" Text="👥 Работники" />
                                <TextBlock
                                    FontSize="40"
                                    FontWeight="Bold"
                                    Text="124" />
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource ModernCard}">
                            <StackPanel>
                                <TextBlock FontSize="22" Text="📋 Задачи" />
                                <TextBlock
                                    FontSize="40"
                                    FontWeight="Bold"
                                    Text="36" />
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource ModernCard}">
                            <StackPanel>
                                <TextBlock FontSize="22" Text="🏢 Организации" />
                                <TextBlock
                                    FontSize="40"
                                    FontWeight="Bold"
                                    Text="3" />
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource ModernCard}">
                            <StackPanel>
                                <TextBlock FontSize="22" Text="⚠ События" />
                                <TextBlock
                                    FontSize="40"
                                    FontWeight="Bold"
                                    Text="12" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!--  Последние действия  -->
                    <Border Grid.Row="2" Style="{DynamicResource ModernCard}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,15"
                                FontSize="26"
                                FontWeight="Bold"
                                Text="Последние события" />
                            <TextBlock Text="• Добавлен новый сотрудник" />
                            <TextBlock Text="• Создана задача" />
                            <TextBlock Text="• Изменены настройки" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>