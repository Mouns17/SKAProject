<Page
    x:Class="SKAProject.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Главное меню"
    Background="{DynamicResource ContentBackgroundBrush}"
    FontFamily="Arian">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  1. Приветственный блок с аватаром  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,20"
            Padding="25"
            Background="{DynamicResource BackgroundColor3}"
            CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="20"
                    Opacity="0.12"
                    ShadowDepth="0"
                    Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Width="80"
                    Height="80"
                    Margin="0,0,20,0"
                    Background="{DynamicResource BackgroundColor6}"
                    CornerRadius="40">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="42"
                        Foreground="White"
                        Text="👤" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="TxtWelcomeUser"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ForegroundColor1}"
                        Text="Добро пожаловать!" />
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,5,0"
                            FontSize="16"
                            Foreground="{DynamicResource BackgroundColor6}"
                            Text="Роль:" />
                        <TextBlock
                            x:Name="TxtRole"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource BackgroundColor6}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="TxtCurrentDate"
                        Margin="0,10,0,0"
                        FontSize="16"
                        Foreground="{DynamicResource ForegroundColor1}"
                        Opacity="0.6" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  2. Карточки с ключевыми показателями  -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Всего сотрудников  -->
                <Border
                    Grid.Column="0"
                    Margin="0,0,15,0"
                    Padding="20"
                    Background="{DynamicResource BackgroundColor3}"
                    CornerRadius="20">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="15"
                            Opacity="0.8"
                            ShadowDepth="0"
                            Color="#010210" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="30"
                            Text="👥" />
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Сотрудников (активных)" />
                        <TextBlock
                            x:Name="TxtTotalEmployees"
                            Margin="0,5,0,0"
                            FontSize="36"
                            FontWeight="Bold"
                            Foreground="#6366F1"
                            Text="0" />
                    </StackPanel>
                </Border>

                <!--  Мои активные задачи  -->
                <Border
                    Grid.Column="1"
                    Margin="0,0,15,0"
                    Padding="20"
                    Background="{DynamicResource BackgroundColor3}"
                    CornerRadius="20">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="15"
                            Opacity="0.8"
                            ShadowDepth="0"
                            Color="#010210" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="30"
                            Text="📋" />
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Мои активные задачи" />
                        <TextBlock
                            x:Name="TxtMyTasks"
                            Margin="0,5,0,0"
                            FontSize="36"
                            FontWeight="Bold"
                            Foreground="#10B981"
                            Text="0" />
                    </StackPanel>
                </Border>

                <!--  Новых задач за неделю  -->
                <Border
                    Grid.Column="2"
                    Margin="0,0,15,0"
                    Padding="20"
                    Background="{DynamicResource BackgroundColor3}"
                    CornerRadius="20">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="15"
                            Opacity="0.8"
                            ShadowDepth="0"
                            Color="#010210" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="30"
                            Text="⭐" />
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Новых задач за неделю" />
                        <TextBlock
                            x:Name="TxtRecentTasks"
                            Margin="0,5,0,0"
                            FontSize="36"
                            FontWeight="Bold"
                            Foreground="#F59E0B"
                            Text="0" />
                    </StackPanel>
                </Border>

                <!--  Отчётов на проверке  -->
                <Border
                    Grid.Column="3"
                    Padding="20"
                    Background="{DynamicResource BackgroundColor3}"
                    CornerRadius="20">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="15"
                            Opacity="0.8"
                            ShadowDepth="0"
                            Color="#010210" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="30"
                            Text="📄" />
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Отчётов на проверке" />
                        <TextBlock
                            x:Name="TxtPendingReports"
                            Margin="0,5,0,0"
                            FontSize="36"
                            FontWeight="Bold"
                            Foreground="#8B5CF6"
                            Text="0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!--  3. Прогресс-бар и быстрые действия  -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Прогресс выполнения задач  -->
            <Border
                Grid.Column="0"
                Margin="0,0,15,0"
                Padding="20"
                Background="{DynamicResource BackgroundColor3}"
                CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="15"
                        Opacity="0.8"
                        ShadowDepth="0"
                        Color="#010210" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,15"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ForegroundColor1}"
                        Text="📈 Прогресс задач" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,5"
                            FontSize="16"
                            Foreground="{DynamicResource ForegroundColor1}">
                            <Run Text="Выполнено " />
                            <Run x:Name="TxtCompletedTasks" Text="0" />
                            <Run Text=" из " />
                            <Run x:Name="TxtTotalTasks" Text="0" />
                        </TextBlock>
                        <Border
                            Grid.Row="1"
                            Height="12"
                            Margin="0,0,0,10"
                            Background="#E2E8F0"
                            CornerRadius="6">
                            <ProgressBar
                                x:Name="TaskProgressBar"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#10B981"
                                Maximum="100"
                                Minimum="0"
                                Value="0" />
                        </Border>
                        <TextBlock
                            x:Name="TxtProgressPercent"
                            Grid.Row="2"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#10B981"
                            Text="0%" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Быстрые действия  -->
            <Border
                Grid.Column="1"
                Width="280"
                Padding="20"
                Background="{DynamicResource BackgroundColor3}"
                CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="15"
                        Opacity="0.8"
                        ShadowDepth="0"
                        Color="#010210" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,15"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ForegroundColor1}"
                        Text="⚡ Быстрые действия" />
                    <Button
                        Height="40"
                        Margin="0,0,0,10"
                        Background="{DynamicResource BackgroundColor6}"
                        BorderThickness="0"
                        Click="OpenMyTasks"
                        Content="📋 Мои задачи"
                        Cursor="Hand"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button
                        Height="40"
                        Margin="0,0,0,10"
                        Background="{DynamicResource BackgroundColor6}"
                        BorderThickness="0"
                        Click="OpenSendReport"
                        Content="📄 Отправить отчёт"
                        Cursor="Hand"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button
                        Height="40"
                        Background="{DynamicResource BackgroundColor6}"
                        BorderThickness="0"
                        Click="OpenProfile"
                        Content="👤 Профиль"
                        Cursor="Hand"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!--  4. Последние уведомления (вместо системных логов)  -->
        <Border
            Grid.Row="3"
            Background="{DynamicResource BackgroundColor3}"
            CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    Opacity="0.8"
                    ShadowDepth="0"
                    Color="#010210" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="NotificationsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="10,8"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Width="36"
                                            Height="36"
                                            Margin="0,0,12,0"
                                            Background="#E0E7FF"
                                            CornerRadius="18">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="18"
                                                Text="{Binding Icon}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="16"
                                                Foreground="#2D3748"
                                                Text="{Binding Message}" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                FontSize="13"
                                                Foreground="#8899AA"
                                                Text="{Binding TimeAgo}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>