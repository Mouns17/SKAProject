<Page x:Class="SKAProject.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Height="1080"
      Width="1520"
      FontFamily="Arian">

    <Grid Margin="0 60 0 0">

        <Border BorderBrush="{StaticResource BackgroundColor6}"
        BorderThickness="1"
        CornerRadius="30"
        Background="#EDF4FF"
        Margin="-5,0,-5,15">

            <ScrollViewer>

                <Grid Margin="40,30,40,50">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->

                    <StackPanel Grid.Row="0" Margin="0,0,0,32">

                        <TextBlock Text="Главное меню"
           FontSize="40"
           FontWeight="SemiBold"
           Foreground="{StaticResource ForegroundColor1}"/>

                        <TextBlock Text="Общая статистика и быстрый доступ"
           FontSize="30"
           Foreground="{StaticResource ForegroundColor1}"
           Margin="0,8,0,0"/>

                    </StackPanel>

                    <!-- Карточки статистики -->

                    <UniformGrid Grid.Row="1"
              Columns="4"
              Margin="0,0,0,30">

                        <Border Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="👥 Работники"
           FontSize="22"/>
                                <TextBlock Text="124"
           FontSize="40"
           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="📋 Задачи"
           FontSize="22"/>
                                <TextBlock Text="36"
           FontSize="40"
           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="🏢 Организации"
           FontSize="22"/>
                                <TextBlock Text="3"
           FontSize="40"
           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="⚠ События"
           FontSize="22"/>
                                <TextBlock Text="12"
           FontSize="40"
           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <!-- Последние действия -->

                    <Border Grid.Row="2"
        Style="{StaticResource ModernCard}">

                        <StackPanel>

                            <TextBlock Text="Последние события"
           FontSize="26"
           FontWeight="Bold"
           Margin="0 0 0 15"/>

                            <TextBlock Text="• Добавлен новый сотрудник"/>
                            <TextBlock Text="• Создана задача"/>
                            <TextBlock Text="• Изменены настройки"/>

                        </StackPanel>

                    </Border>

                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>