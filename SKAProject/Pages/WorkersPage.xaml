<Page x:Class="SKAProject.Pages.WorkersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="WorkersPage"
      Height="1080" Width="1520" FontFamily="Arian">
    <Grid Margin="0 60 0 0">
        <Border BorderBrush="{StaticResource BackgroundColor6}" BorderThickness="1" CornerRadius="30" Background="#EDF4FF" Padding="0" Margin="-5,0,-5,15">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="6"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid>
                                        <Border Background="Transparent"/>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <Grid Margin="40,30,40,50">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок и панель управления -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,32">
                        <TextBlock Text="Сотрудники" FontSize="40" FontWeight="SemiBold" 
                                   Foreground="{StaticResource ForegroundColor1}"/>
                        <TextBlock Text="Управление персоналом организации" 
                                   FontSize="30" Foreground="{StaticResource ForegroundColor1}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Панель инструментов (поиск, фильтр, кнопки) -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <!-- Верхняя строка: Поиск и кнопки -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Поисковая строка -->
                            <Border Grid.Column="0" Height="55" CornerRadius="15" Background="{StaticResource BackgroundColor3}" Margin="0,0,20,0">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="0" Color="#010210" Opacity="0.8" BlurRadius="15"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="20" VerticalAlignment="Center" Margin="20,0,10,0" Foreground="{StaticResource ForegroundColor1}"/>
                                    <TextBox x:Name="SearchTextBox" Grid.Column="1" 
                                             FontSize="18" VerticalAlignment="Center" 
                                             BorderThickness="0" Background="Transparent"
                                             Foreground="{StaticResource ForegroundColor1}"
                                             FontFamily="Arian"/>
                                    <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" 
                                               Text="Поиск по имени, email, телефону..." 
                                               FontSize="18" VerticalAlignment="Center" 
                                               IsHitTestVisible="False"
                                               Foreground="#8899AA" FontFamily="Arian"
                                               Margin="2,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Кнопки справа -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- Кнопка Добавить -->
                                <Button x:Name="AddWorkerButton" Height="55" Width="200" Margin="0,0,15,0" 
                                        Background="#6366F1" Cursor="Hand" FontWeight="SemiBold" Click="AddWorkerButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                                <Border.Effect>
                                                    <DropShadowEffect ShadowDepth="0" Color="#6366F1" Opacity="0.4" BlurRadius="15"/>
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕" Margin="0,0,8,0" Foreground="White" FontSize="18"/>
                                        <TextBlock Text="Добавить сотрудника" Foreground="White" FontSize="18"/>
                                    </StackPanel>
                                </Button>

                                <!-- Кнопка Редактировать -->
                                <Button x:Name="EditWorkerButton" Height="55" Width="180" 
                                        Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" 
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                    CornerRadius="15">
                                                <Border.Effect>
                                                    <DropShadowEffect ShadowDepth="0" Color="#000000" Opacity="0.3" BlurRadius="15"/>
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✏️" Margin="0,0,8,0" Foreground="White" FontSize="18"/>
                                        <TextBlock Text="Редактировать" Foreground="White" FontSize="18"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Нижняя строка: Фильтры -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Фильтр по отделу -->
                            <TextBlock Grid.Column="0" Text="Отдел:" VerticalAlignment="Center" FontSize="20" 
                                       Foreground="{StaticResource ForegroundColor1}" Margin="0,0,15,0"/>
                            <ComboBox x:Name="DepartmentFilterComboBox" Grid.Column="1" Height="45" 
                                      FontSize="18" Background="{StaticResource BackgroundColor3}" 
                                      Foreground="{StaticResource ForegroundColor1}"
                                      BorderThickness="0" Margin="0,0,25,0">
                                <ComboBox.Effect>
                                    <DropShadowEffect ShadowDepth="0" Color="#010210" Opacity="0.5" BlurRadius="10"/>
                                </ComboBox.Effect>
                                <ComboBoxItem Content="Все отделы" IsSelected="True"/>
                            </ComboBox>

                            <!-- Фильтр по должности -->
                            <TextBlock Grid.Column="2" Text="Должность:" VerticalAlignment="Center" FontSize="20" 
                                       Foreground="{StaticResource ForegroundColor1}" Margin="0,0,15,0"/>
                            <ComboBox x:Name="PositionFilterComboBox" Grid.Column="3" Height="45" 
                                      FontSize="18" Background="{StaticResource BackgroundColor3}" 
                                      Foreground="{StaticResource ForegroundColor1}"
                                      BorderThickness="0" Margin="0,0,25,0">
                                <ComboBox.Effect>
                                    <DropShadowEffect ShadowDepth="0" Color="#010210" Opacity="0.5" BlurRadius="10"/>
                                </ComboBox.Effect>
                                <ComboBoxItem Content="Все должности" IsSelected="True"/>
                            </ComboBox>

                            <!-- Фильтр по статусу -->
                            <TextBlock Grid.Column="4" Text="Статус:" VerticalAlignment="Center" FontSize="20" 
                                       Foreground="{StaticResource ForegroundColor1}" Margin="0,0,15,0"/>
                            <ComboBox x:Name="StatusFilterComboBox" Grid.Column="5" Height="45" 
                                      FontSize="18" Background="{StaticResource BackgroundColor3}" 
                                      Foreground="{StaticResource ForegroundColor1}"
                                      BorderThickness="0">
                                <ComboBox.Effect>
                                    <DropShadowEffect ShadowDepth="0" Color="#010210" Opacity="0.5" BlurRadius="10"/>
                                </ComboBox.Effect>
                                <ComboBoxItem Content="Все статусы" IsSelected="True"/>
                                <ComboBoxItem Content="Работает"/>
                                <ComboBoxItem Content="Уволен"/>
                                <ComboBoxItem Content="В отпуске"/>
                            </ComboBox>

                            <!-- Кнопка сброса фильтров -->
                            <Button x:Name="ResetFiltersButton" Grid.Column="6" HorizontalAlignment="Right"
                                    Height="45" Width="150" Background="Transparent" 
                                    BorderBrush="#6366F1" BorderThickness="2" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="15">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" Margin="0,0,8,0" Foreground="#6366F1" FontSize="16"/>
                                    <TextBlock Text="Сбросить" Foreground="#6366F1" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Таблица сотрудников в стиле логов -->
                    <Border Grid.Row="2" CornerRadius="20" Background="{StaticResource BackgroundColor3}">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="0" Color="#010210" Opacity="1" BlurRadius="15"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Заголовок таблицы -->
                            <Border Grid.Row="0" Background="#F0F5FF" CornerRadius="20 20 0 0" 
                                    BorderBrush="#D0D9E8" BorderThickness="0,0,0,2">
                                <Grid Height="60">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="15,0,0,0" 
                                              x:Name="SelectAllCheckBox" Cursor="Hand"/>

                                    <TextBlock Grid.Column="1" Text="ФИО" FontSize="18" FontWeight="Bold" 
                                               Foreground="#4A5568" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="Отдел" FontSize="18" FontWeight="Bold" 
                                               Foreground="#4A5568" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="3" Text="Должность" FontSize="18" FontWeight="Bold" 
                                               Foreground="#4A5568" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="4" Text="Телефон" FontSize="18" FontWeight="Bold" 
                                               Foreground="#4A5568" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="5" Text="Email" FontSize="18" FontWeight="Bold" 
                                               Foreground="#4A5568" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="6" Text="Статус" FontSize="18" FontWeight="Bold" 
                                               Foreground="#4A5568" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Список сотрудников -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Width" Value="6"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </ScrollViewer.Resources>

                                <ItemsControl x:Name="WorkersItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" 
                                                    Background="Transparent">
                                                <Grid Height="65">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="250"/>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="50"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="15,0,0,0" 
                                                              IsChecked="{Binding IsSelected}" Cursor="Hand"/>

                                                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding FullName}" FontSize="16" FontWeight="SemiBold" 
                                                                   Foreground="#2D3748"/>
                                                        <TextBlock Text="{Binding WorkerId}" FontSize="12" Foreground="#A0AEC0"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding Department}" FontSize="16" 
                                                               Foreground="#4A5568" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Position}" FontSize="16" 
                                                               Foreground="#4A5568" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Phone}" FontSize="16" 
                                                               Foreground="#4A5568" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding Email}" FontSize="16" 
                                                               Foreground="#4A5568" VerticalAlignment="Center" Margin="10,0,0,0"/>

                                                    <!-- Статус с цветовой индикацией -->
                                                    <Border Grid.Column="6" VerticalAlignment="Center" Margin="10,0,0,0"
                                                            CornerRadius="20" Padding="10,5" HorizontalAlignment="Left"
                                                            Background="{Binding StatusColor}">
                                                        <TextBlock Text="{Binding Status}" FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                    </Border>

                                                    <!-- Кнопки действий -->
                                                    <StackPanel Grid.Column="7" Orientation="Horizontal" 
                                                                VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <Button Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                                CommandParameter="{Binding WorkerId}">
                                                            <TextBlock Text="✏️" FontSize="18"/>
                                                        </Button>
                                                        <Button Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                                CommandParameter="{Binding WorkerId}" Margin="10,0,0,0">
                                                            <TextBlock Text="🗑️" FontSize="18"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>