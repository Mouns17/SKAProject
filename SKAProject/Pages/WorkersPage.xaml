<Page
    x:Class="SKAProject.Pages.WorkersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WorkersPage"
    Width="1520"
    Height="1080"
    FontFamily="Arian">
    <Grid Margin="0,60,0,0">
        <Border
            Margin="-5,0,-5,15"
            Padding="0"
            Background="#EDF4FF"
            BorderBrush="{DynamicResource BackgroundColor6}"
            BorderThickness="1"
            CornerRadius="30">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="6" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid>
                                        <Border Background="Transparent" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <Grid Margin="40,30,40,50">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Заголовок и панель управления  -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,32">
                        <TextBlock
                            FontSize="40"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Сотрудники" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="30"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Управление персоналом организации" />
                    </StackPanel>

                    <!--  Панель инструментов (поиск, фильтр, кнопки)  -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <!--  Верхняя строка: Поиск и кнопки  -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Поисковая строка  -->
                            <Border
                                Grid.Column="0"
                                Height="55"
                                Margin="0,0,20,0"
                                Background="{DynamicResource BackgroundColor3}"
                                BorderBrush="{DynamicResource BackgroundColor6}"
                                BorderThickness="1"
                                CornerRadius="15">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="15"
                                        Opacity="0.8"
                                        ShadowDepth="0"
                                        Color="#010210" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="20,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Foreground="{DynamicResource ForegroundColor1}"
                                        Text="🔍" />
                                    <TextBox
                                        x:Name="SearchTextBox"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontFamily="Arian"
                                        FontSize="18"
                                        Foreground="{DynamicResource ForegroundColor1}" />
                                    <TextBlock
                                        x:Name="SearchPlaceholder"
                                        Grid.Column="1"
                                        Margin="2,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Arian"
                                        FontSize="18"
                                        Foreground="#8899AA"
                                        IsHitTestVisible="False"
                                        Text="Поиск по имени, email, телефону..." />
                                </Grid>
                            </Border>

                            <!--  Кнопки справа  -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!--  Кнопка Добавить  -->
                                <Button
                                    x:Name="AddWorkerButton"
                                    Width="200"
                                    Height="55"
                                    Margin="0,0,15,0"
                                    Background="#6366F1"
                                    Click="AddWorkerButton_Click"
                                    Cursor="Hand"
                                    FontWeight="SemiBold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                                <Border.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="15"
                                                        Opacity="0.4"
                                                        ShadowDepth="0"
                                                        Color="#6366F1" />
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,8,0"
                                            FontSize="15"
                                            Foreground="White"
                                            Text="➕" />
                                        <TextBlock
                                            FontSize="15"
                                            Foreground="White"
                                            Text="Добавить сотрудника" />
                                    </StackPanel>
                                </Button>

                                <!--  Кнопка Редактировать  -->
                                <Button
                                    x:Name="EditWorkerButton"
                                    Width="180"
                                    Height="55"
                                    Background="#6366F1"
                                    Click="EditWorkerButton_Click"
                                    Cursor="Hand"
                                    FontWeight="SemiBold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                                <Border.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="15"
                                                        Opacity="0.3"
                                                        ShadowDepth="0"
                                                        Color="White" />
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,8,0"
                                            FontSize="15"
                                            Foreground="White"
                                            Text="✏️" />
                                        <TextBlock
                                            FontSize="15"
                                            Foreground="White"
                                            Text="Редактировать" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!--  Нижняя строка: Фильтры  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Фильтр по отделу  -->
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,15,0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{DynamicResource ForegroundColor1}"
                                Text="Отдел:" />
                            <ComboBox
                                x:Name="DepartmentFilterComboBox"
                                Grid.Column="1"
                                Height="45"
                                Margin="0,0,25,0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="{DynamicResource BackgroundColor3}"
                                BorderThickness="0"
                                FontSize="18"
                                Foreground="{DynamicResource ForegroundColor1}">
                                <ComboBox.Effect>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        Opacity="0.5"
                                        ShadowDepth="0"
                                        Color="#010210" />
                                </ComboBox.Effect>
                                <ComboBoxItem Content="Все отделы" IsSelected="True" />
                            </ComboBox>

                            <!--  Фильтр по должности  -->
                            <TextBlock
                                Grid.Column="2"
                                Margin="0,0,15,0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{DynamicResource ForegroundColor1}"
                                Text="Должность:" />
                            <ComboBox
                                x:Name="PositionFilterComboBox"
                                Grid.Column="3"
                                Height="45"
                                Margin="0,0,25,0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="{DynamicResource BackgroundColor3}"
                                BorderThickness="0"
                                FontSize="18"
                                Foreground="{DynamicResource ForegroundColor1}">
                                <ComboBox.Effect>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        Opacity="0.5"
                                        ShadowDepth="0"
                                        Color="#010210" />
                                </ComboBox.Effect>
                                <ComboBoxItem Content="Все должности" IsSelected="True" />
                            </ComboBox>

                            <!--  Фильтр по статусу  -->
                            <TextBlock
                                Grid.Column="4"
                                Margin="0,0,15,0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{DynamicResource ForegroundColor1}"
                                Text="Статус:" />
                            <ComboBox
                                x:Name="StatusFilterComboBox"
                                Grid.Column="5"
                                Height="45"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="{DynamicResource BackgroundColor3}"
                                BorderThickness="0"
                                FontSize="18"
                                Foreground="{DynamicResource ForegroundColor1}">
                                <ComboBox.Effect>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        Opacity="0.5"
                                        ShadowDepth="0"
                                        Color="#010210" />
                                </ComboBox.Effect>
                                <ComboBoxItem Content="Все статусы" IsSelected="True" />
                                <ComboBoxItem Content="Работает" />
                                <ComboBoxItem Content="Уволен" />
                                <ComboBoxItem Content="В отпуске" />
                            </ComboBox>

                            <Button
                                Grid.Column="7"
                                Margin="0,0,160,0"
                                Click="CreateTaskBtn_Click"
                                Content="Создать задачу"
                                Cursor="Hand"
                                Style="{DynamicResource TaskBtnStyle}" />

                            <Button
                                Grid.Column="7"
                                Margin="140,0,0,0"
                                Click="DeleteBtn_Click"
                                Content="Удалить"
                                Cursor="Hand"
                                Style="{DynamicResource DeleteBtnStyle}" />

                            <Button
                                Grid.Column="7"
                                Margin="440,0,0,0"
                                Click="ExportBtn_Click"
                                Content="Экспорт в Excel"
                                Cursor="Hand"
                                Style="{DynamicResource ExportBtnStyle}" />
                        </Grid>
                    </StackPanel>

                    <!--  Таблица сотрудников в стиле логов  -->
                    <Border
                        Grid.Row="2"
                        Background="{DynamicResource BackgroundColor3}"
                        CornerRadius="20">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="15"
                                Opacity="1"
                                ShadowDepth="0"
                                Color="#010210" />
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Заголовок таблицы  -->
                            <Border
                                Grid.Row="0"
                                Background="#F0F5FF"
                                BorderBrush="#D0D9E8"
                                BorderThickness="0,0,0,2"
                                CornerRadius="20 20 0 0">
                                <Grid Height="60">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="350" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="250" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="0,0,0,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#4A5568"
                                        Text="ID" />

                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="0,0,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#4A5568"
                                        Text="ФИО" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#4A5568"
                                        Text="Отдел" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#4A5568"
                                        Text="Должность" />
                                    <TextBlock
                                        Grid.Column="5"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#4A5568"
                                        Text="Телефон" />
                                    <TextBlock
                                        Grid.Column="6"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#4A5568"
                                        Text="Email" />
                                    <TextBlock
                                        Grid.Column="7"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#4A5568"
                                        Text="Статус" />
                                </Grid>
                            </Border>

                            <!--  Список сотрудников  -->
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Width" Value="6" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </ScrollViewer.Resources>

                                <ItemsControl x:Name="WorkersItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Background="Transparent"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="0,0,0,1">
                                                <Grid Height="65">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="350" />
                                                        <ColumnDefinition Width="200" />
                                                        <ColumnDefinition Width="230" />
                                                        <ColumnDefinition Width="200" />
                                                        <ColumnDefinition Width="250" />
                                                        <ColumnDefinition Width="100" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox
                                                        Grid.Column="0"
                                                        Margin="15,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Cursor="Hand"
                                                        IsChecked="{Binding IsSelected}" />

                                                    <!--  ID  -->
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="0,0,0,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="#4A5568"
                                                        Text="{Binding WrkId}" />

                                                    <!--  ФИО  -->
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Margin="0,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        FontWeight="SemiBold"
                                                        Foreground="#2D3748"
                                                        Text="{Binding FullName}" />

                                                    <!--  Отдел  -->
                                                    <TextBlock
                                                        x:Name="txtDepartment"
                                                        Grid.Column="3"
                                                        Margin="0,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="#4A5568"
                                                        Text="{Binding Department}"
                                                        Visibility="Visible" />
                                                    <ComboBox
                                                        x:Name="cmbDepartment"
                                                        Grid.Column="3"
                                                        Width="190"
                                                        Height="30"
                                                        Margin="0,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        Visibility="Collapsed" />

                                                    <!--  Должность  -->
                                                    <TextBlock
                                                        x:Name="txtPosition"
                                                        Grid.Column="4"
                                                        Margin="0,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="#4A5568"
                                                        Text="{Binding Position}"
                                                        Visibility="Visible" />
                                                    <ComboBox
                                                        x:Name="cmbPosition"
                                                        Grid.Column="4"
                                                        Width="220"
                                                        Height="30"
                                                        Margin="0,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        Visibility="Collapsed" />

                                                    <!--  Телефон (не редактируем)  -->
                                                    <TextBlock
                                                        Grid.Column="5"
                                                        Margin="0,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="#4A5568"
                                                        Text="{Binding Phone}" />

                                                    <!--  Email (не редактируем)  -->
                                                    <TextBlock
                                                        Grid.Column="6"
                                                        Margin="0,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="#4A5568"
                                                        Text="{Binding Email}" />

                                                    <!--  Статус  -->
                                                    <Border
                                                        x:Name="brdStatus"
                                                        Grid.Column="7"
                                                        Margin="0,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding StatusColor}"
                                                        CornerRadius="10"
                                                        Visibility="Visible">
                                                        <TextBlock
                                                            Margin="5,2"
                                                            HorizontalAlignment="Left"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="White"
                                                            Text="{Binding Status}" />
                                                    </Border>
                                                    <ComboBox
                                                        x:Name="cmbStatus"
                                                        Grid.Column="7"
                                                        Width="90"
                                                        Height="30"
                                                        Margin="0,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        Visibility="Collapsed" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <!--  Скрываем текст, показываем ComboBox  -->
                                                    <Setter TargetName="txtDepartment" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="cmbDepartment" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="txtPosition" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="cmbPosition" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="brdStatus" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="cmbStatus" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>