<Page
    x:Class="SKAProject.Pages.WorkersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Сотрудники"
    Background="{DynamicResource ContentBackgroundBrush}"
    FontFamily="Arian">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Заголовок  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock
                FontSize="36"
                FontWeight="SemiBold"
                Foreground="{DynamicResource ForegroundColor1}"
                Text="Сотрудники" />
            <TextBlock
                Margin="0,8,0,0"
                FontSize="22"
                Foreground="{DynamicResource ForegroundColor1}"
                Text="Управление персоналом организации" />
        </StackPanel>

        <!--  Поиск и кнопки  -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                Height="55"
                Margin="0,0,20,0"
                Background="{DynamicResource BackgroundColor3}"
                BorderBrush="{DynamicResource BackgroundColor6}"
                BorderThickness="1"
                CornerRadius="15">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="15"
                        Opacity="0.8"
                        ShadowDepth="0"
                        Color="#010210" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="20,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{DynamicResource ForegroundColor1}"
                        Text="🔍" />
                    <TextBox
                        x:Name="SearchTextBox"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="Arian"
                        FontSize="18"
                        Foreground="{DynamicResource ForegroundColor1}" />
                    <TextBlock
                        x:Name="SearchPlaceholder"
                        Grid.Column="1"
                        Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="Arian"
                        FontSize="18"
                        Foreground="#8899AA"
                        IsHitTestVisible="False"
                        Text="Поиск по имени, email, телефону..." />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button
                    x:Name="AddWorkerButton"
                    Width="200"
                    Height="55"
                    Margin="0,0,15,0"
                    Background="{DynamicResource BackgroundColor6}"
                    BorderThickness="0"
                    Click="AddWorkerButton_Click"
                    Cursor="Hand"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            FontSize="20"
                            Text="+" />
                        <TextBlock Text="Добавить сотрудника" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="EditWorkerButton"
                    Width="180"
                    Height="55"
                    Background="{DynamicResource BackgroundColor6}"
                    BorderThickness="0"
                    Click="EditWorkerButton_Click"
                    Cursor="Hand"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            FontSize="16"
                            Text="✏️" />
                        <TextBlock Text="Редактировать" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--  Фильтры  -->
        <WrapPanel
            Grid.Row="2"
            Margin="0,0,0,15"
            VerticalAlignment="Center">
            <TextBlock
                Margin="0,0,15,0"
                VerticalAlignment="Center"
                FontSize="18"
                Foreground="{DynamicResource ForegroundColor1}"
                Text="Отдел:" />
            <ComboBox
                x:Name="DepartmentFilterComboBox"
                Width="200"
                Height="45"
                Margin="0,0,25,0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="{DynamicResource BackgroundColor3}"
                BorderThickness="0"
                FontSize="16"
                Foreground="{DynamicResource ForegroundColor1}">
                <ComboBox.Effect>
                    <DropShadowEffect
                        BlurRadius="10"
                        Opacity="0.5"
                        ShadowDepth="0"
                        Color="#010210" />
                </ComboBox.Effect>
            </ComboBox>
            <TextBlock
                Margin="0,0,15,0"
                VerticalAlignment="Center"
                FontSize="18"
                Foreground="{DynamicResource ForegroundColor1}"
                Text="Должность:" />
            <ComboBox
                x:Name="PositionFilterComboBox"
                Width="200"
                Height="45"
                Margin="0,0,25,0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="{DynamicResource BackgroundColor3}"
                BorderThickness="0"
                FontSize="16"
                Foreground="{DynamicResource ForegroundColor1}">
                <ComboBox.Effect>
                    <DropShadowEffect
                        BlurRadius="10"
                        Opacity="0.5"
                        ShadowDepth="0"
                        Color="#010210" />
                </ComboBox.Effect>
            </ComboBox>
            <TextBlock
                Margin="0,0,15,0"
                VerticalAlignment="Center"
                FontSize="18"
                Foreground="{DynamicResource ForegroundColor1}"
                Text="Статус:" />
            <ComboBox
                x:Name="StatusFilterComboBox"
                Width="200"
                Height="45"
                Margin="0,0,25,0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="{DynamicResource BackgroundColor3}"
                BorderThickness="0"
                FontSize="16"
                Foreground="{DynamicResource ForegroundColor1}">
                <ComboBox.Effect>
                    <DropShadowEffect
                        BlurRadius="10"
                        Opacity="0.5"
                        ShadowDepth="0"
                        Color="#010210" />
                </ComboBox.Effect>
            </ComboBox>
        </WrapPanel>

        <!--  Таблица сотрудников (без изменений)  -->
        <Border
            Grid.Row="3"
            Background="{DynamicResource BackgroundColor3}"
            CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    Opacity="1"
                    ShadowDepth="0"
                    Color="#010210" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Background="#F0F5FF"
                    BorderBrush="#D0D9E8"
                    BorderThickness="0,0,0,2"
                    CornerRadius="20 20 0 0">
                    <Grid Height="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="350" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#4A5568"
                            Text="ID" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#4A5568"
                            Text="ФИО" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#4A5568"
                            Text="Отдел" />
                        <TextBlock
                            Grid.Column="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#4A5568"
                            Text="Должность" />
                        <TextBlock
                            Grid.Column="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#4A5568"
                            Text="Телефон" />
                        <TextBlock
                            Grid.Column="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#4A5568"
                            Text="Email" />
                        <TextBlock
                            Grid.Column="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#4A5568"
                            Text="Статус" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="WorkersItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Background="Transparent"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="0,0,0,1">
                                    <Grid Height="50">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="350" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="250" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="#4A5568"
                                            Text="{Binding WrkID}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="#2D3748"
                                            Text="{Binding FullName}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="#4A5568"
                                            Text="{Binding Department}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="#4A5568"
                                            Text="{Binding Position}" />
                                        <TextBlock
                                            Grid.Column="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="#4A5568"
                                            Text="{Binding Phone}" />
                                        <TextBlock
                                            Grid.Column="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="#4A5568"
                                            Text="{Binding Email}" />
                                        <Border
                                            Grid.Column="6"
                                            HorizontalAlignment="Center"
                                            Background="{Binding StatusColor}"
                                            CornerRadius="10">
                                            <TextBlock
                                                Margin="10,2"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding Status}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>