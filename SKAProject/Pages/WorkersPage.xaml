<Page x:Class="SKAProject.Pages.WorkersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="WorkersPage"
      Height="1080" Width="1520" Background="Transparent" FontFamily="Arian">
    <Grid >
        <Border CornerRadius="30" Background="#EDF4FF" Padding="0" Margin="-5,0,-5,15">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="6"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <Grid Margin="40,30,40,50">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ========== ЗАГОЛОВОК ========== -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Список работников" FontSize="40" FontWeight="SemiBold" 
                               Foreground="#010002"/>
                        </StackPanel>
                        <TextBlock Text="Управление сотрудниками и их профилями" 
                           FontSize="30" Foreground="#010002" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- ========== БАННЕР С МЕТРИКАМИ ========== -->
                    <Border Grid.Row="1" Height="120" CornerRadius="20" Margin="0,0,0,32">
                        <Border.Background>
                            <LinearGradientBrush EndPoint="1,1">
                                <GradientStop Color="#6366F1" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="0.5"/>
                                <GradientStop Color="#EC4899" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid Margin="30,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Метрика 1 -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="TotalWorkers" Text="12" FontSize="50" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Всего сотрудников" FontSize="20" Foreground="#E0E0E0" Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- Метрика 2 -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="ActiveWorkers" Text="4" FontSize="50" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Активных" FontSize="20" Foreground="#E0E0E0" Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- Метрика 3 -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="NewThisMonth" Text="3" FontSize="50" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Новых в этом месяце" FontSize="20" Foreground="#E0E0E0" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ========== ФИЛЬТРЫ И ПОИСК ========== -->
                    <Border Grid.Row="2" Style="{StaticResource WorkerCardStyle}" Margin="0,0,0,24" Padding="6">
                        <Grid Margin="-20,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Поиск -->
                            <Border Grid.Column="0" Background="#EDF4FF" CornerRadius="12" Height="30" Width="1030">
                                <DockPanel Margin="0 0 0 0">
                                    <TextBlock Text="🔍" FontSize="14" DockPanel.Dock="Left" Foreground="#666666" Margin="5 7 0 0"/>
                                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
                                     Background="Transparent" BorderThickness="0" 
                                     Foreground="White" FontSize="13" Margin="8,0,0,0"
                                     VerticalContentAlignment="Center">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <Grid>
                                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="Placeholder" Text="Поиск по имени, должности..." 
                                                                   Foreground="#666666" IsHitTestVisible="False"
                                                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="Text" Value="">
                                                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DockPanel>
                            </Border>

                            <!-- Фильтры -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ComboBox x:Name="DepartmentFilter" SelectionChanged="FilterChanged" Width="160" Height="30" Margin="0,0,12,0">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="Background" Value="#1A1A1A"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#2A2A2A"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Padding" Value="12,0"/>
                                        </Style>
                                    </ComboBox.Style>
                                    <ComboBoxItem Content="Все отделы" IsSelected="True"/>
                                    <ComboBoxItem Content="Администрация"/>
                                    <ComboBoxItem Content="Отдел аналитики"/>
                                    <ComboBoxItem Content="IT-департамент"/>
                                    <ComboBoxItem Content="Отдел контроля"/>
                                </ComboBox>

                                <ComboBox x:Name="StatusFilter" SelectionChanged="FilterChanged" Width="140" Height="30">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="Background" Value="#1A1A1A"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#2A2A2A"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Padding" Value="12,0"/>
                                        </Style>
                                    </ComboBox.Style>
                                    <ComboBoxItem Content="Все статусы" IsSelected="True"/>
                                    <ComboBoxItem Content="Активен"/>
                                    <ComboBoxItem Content="В отпуске"/>
                                    <ComboBoxItem Content="Удалён"/>
                                </ComboBox>

                                <!-- Кнопка добавить -->
                                <Button Width="40" Height="40" Margin="12,0,0,0" Background="#6366F1" Cursor="Hand" Click="AddWorker_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="+" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

