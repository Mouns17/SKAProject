<Page
    x:Class="SKAProject.Pages.CreateRequestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Создание заявки"
    Background="{DynamicResource ContentBackgroundBrush}"
    FontFamily="Arian">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Заголовок  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock
                FontSize="36"
                FontWeight="SemiBold"
                Foreground="{DynamicResource ForegroundColor1}"
                Text="Создание заявки" />
            <TextBlock
                Margin="0,8,0,0"
                FontSize="22"
                Foreground="{DynamicResource ForegroundColor1}"
                Text="Подайте заявку на отпуск, отгул или командировку" />
        </StackPanel>

        <!--  Форма  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,20"
            Padding="25"
            Background="{DynamicResource BackgroundColor3}"
            CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="20"
                    Opacity="0.12"
                    ShadowDepth="0"
                    Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <!--  Тип заявки  -->
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource ForegroundColor1}"
                    Text="Тип заявки:" />
                <ComboBox
                    x:Name="CmbRequestType"
                    Height="45"
                    Margin="0,0,0,15"
                    Background="{DynamicResource BackgroundColor3}"
                    FontSize="16"
                    Foreground="{DynamicResource ForegroundColor1}">
                    <ComboBoxItem Content="Отпуск" IsSelected="True" />
                    <ComboBoxItem Content="Отгул" />
                    <ComboBoxItem Content="Командировка" />
                    <ComboBoxItem Content="Больничный" />
                    <ComboBoxItem Content="Материальная помощь" />
                </ComboBox>

                <!--  Причина  -->
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource ForegroundColor1}"
                    Text="Причина:" />
                <TextBox
                    x:Name="TxtReason"
                    Height="100"
                    Margin="0,0,0,15"
                    AcceptsReturn="True"
                    FontSize="16"
                    Style="{DynamicResource TxtBoxStyle}"
                    TextWrapping="Wrap" />

                <!--  Прикрепление файла  -->
                <StackPanel Margin="130,0,130,15" Orientation="Horizontal">
                    <Button
                        x:Name="BtnAttach"
                        Width="200"
                        Height="40"
                        Background="{DynamicResource BackgroundColor6}"
                        BorderThickness="0"
                        Click="BtnAttach_Click"
                        Content="📎 Прикрепить файл"
                        Cursor="Hand"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock
                        x:Name="TxtAttachedFile"
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{DynamicResource ForegroundColor1}" />
                </StackPanel>

                <!--  Кнопка отправки  -->
                <Button
                    x:Name="BtnSubmit"
                    Width="220"
                    Height="45"
                    Background="{DynamicResource BackgroundColor6}"
                    BorderThickness="0"
                    Click="BtnSubmit_Click"
                    Content="Отправить заявку"
                    Cursor="Hand"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>