<Page
    x:Class="SKAProject.Pages.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ReportsPage"
    Width="1520"
    Height="1080"
    FontFamily="Arian">
    <Grid Margin="0,60,0,0">
        <Border
            Margin="-5,0,-5,15"
            Padding="0"
            Background="#EDF4FF"
            BorderBrush="{DynamicResource BackgroundColor6}"
            BorderThickness="1"
            CornerRadius="30">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="6" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid>
                                        <Border Background="Transparent" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <Grid Margin="40,30,40,50">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Заголовок  -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,32">
                        <TextBlock
                            FontSize="40"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Отчеты работников" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="30"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Просмотр и анализ отчетов сотрудников" />
                    </StackPanel>

                    <!--  Панель инструментов  -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Поисковая строка  -->
                            <Border
                                Grid.Column="0"
                                Height="55"
                                Margin="0,0,20,0"
                                Background="{DynamicResource BackgroundColor3}"
                                BorderBrush="{DynamicResource BackgroundColor6}"
                                BorderThickness="1"
                                CornerRadius="15">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="15"
                                        Opacity="0.8"
                                        ShadowDepth="0"
                                        Color="#010210" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="20,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Foreground="{DynamicResource ForegroundColor1}"
                                        Text="🔍" />
                                    <TextBox
                                        x:Name="SearchTextBox"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontFamily="Arian"
                                        FontSize="18"
                                        Foreground="{DynamicResource ForegroundColor1}" />
                                    <TextBlock
                                        x:Name="SearchPlaceholder"
                                        Grid.Column="1"
                                        Margin="2,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Arian"
                                        FontSize="18"
                                        Foreground="#8899AA"
                                        IsHitTestVisible="False"
                                        Text="Поиск по номеру, приоритету, статусу..." />
                                </Grid>
                            </Border>

                            <!--  Кнопка Экспорт  -->
                            <Button
                                Grid.Column="1"
                                Width="230"
                                Height="55"
                                Click="ExportBtn_Click"
                                Content="Экспорт в Excel"
                                Cursor="Hand"
                                Style="{DynamicResource ExportBtnStyle}" />
                        </Grid>
                    </StackPanel>

                    <!--  Основной контент: таблица + статистика  -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Таблица отчётов  -->
                        <Border
                            Grid.Column="0"
                            Margin="0,0,20,0"
                            Background="{DynamicResource BackgroundColor3}"
                            CornerRadius="20">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="15"
                                    Opacity="1"
                                    ShadowDepth="0"
                                    Color="#010210" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  Заголовок таблицы  -->
                                <Border
                                    Grid.Row="0"
                                    Background="#F0F5FF"
                                    BorderBrush="#D0D9E8"
                                    BorderThickness="0,0,0,2"
                                    CornerRadius="20 20 0 0">
                                    <Grid Height="60">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <!--  №  -->
                                            <ColumnDefinition Width="200" />
                                            <!--  От кого  -->
                                            <ColumnDefinition Width="200" />
                                            <!--  Кому  -->
                                            <ColumnDefinition Width="120" />
                                            <!--  Дата  -->
                                            <ColumnDefinition Width="*" />
                                            <!--  Краткое описание  -->
                                            <ColumnDefinition Width="160" />
                                            <!--  Статус  -->
                                            <ColumnDefinition Width="100" />
                                            <!--  Файл  -->
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="№" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="От кого" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="Кому" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="Дата" />
                                        <TextBlock
                                            Grid.Column="4"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="Краткое описание" />
                                        <TextBlock
                                            Grid.Column="5"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="Статус" />
                                        <TextBlock
                                            Grid.Column="6"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="Файл" />
                                    </Grid>
                                </Border>

                                <!--  Список отчётов  -->
                                <ScrollViewer
                                    Grid.Row="1"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar">
                                            <Setter Property="Width" Value="6" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </ScrollViewer.Resources>

                                    <ItemsControl x:Name="ReportsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Background="Transparent"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="0,0,0,1">
                                                    <Grid Height="65">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70" />
                                                            <!--  №  -->
                                                            <ColumnDefinition Width="200" />
                                                            <!--  От кого  -->
                                                            <ColumnDefinition Width="200" />
                                                            <!--  Кому  -->
                                                            <ColumnDefinition Width="120" />
                                                            <!--  Дата  -->
                                                            <ColumnDefinition Width="*" />
                                                            <!--  Описание  -->
                                                            <ColumnDefinition Width="110" />
                                                            <!--  Статус  -->
                                                            <ColumnDefinition Width="160" />
                                                            <!--  Кнопки действий  -->
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Margin="10,0,0,0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Foreground="#4A5568"
                                                            Text="{Binding ReportID}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="10,0,0,0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Foreground="#2D3748"
                                                            Text="{Binding AuthorName}" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Margin="10,0,0,0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Foreground="#2D3748"
                                                            Text="{Binding RecipientName}" />
                                                        <TextBlock
                                                            Grid.Column="3"
                                                            Margin="10,0,0,0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Foreground="#4A5568"
                                                            Text="{Binding ReportDate, StringFormat='dd.MM.yyyy'}" />
                                                        <TextBlock
                                                            Grid.Column="4"
                                                            Margin="10,0,0,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Foreground="#4A5568"
                                                            Text="{Binding Description}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="5"
                                                            Margin="10,0,0,0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding StatusColor}"
                                                            Text="{Binding Status}" />

                                                        <!--  Панель действий  -->
                                                        <StackPanel
                                                            Grid.Column="6"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                            <!--  Скачать файл (только если есть файл)  -->
                                                            <Button
                                                                Margin="5,0"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Click="DownloadFile_Click"
                                                                CommandParameter="{Binding FilePath}"
                                                                Cursor="Hand"
                                                                Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock FontSize="18" Text="📥" />
                                                            </Button>

                                                            <!--  Принять (только если статус «На проверке»)  -->
                                                            <Button
                                                                Margin="5,0"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Click="AcceptReport_Click"
                                                                CommandParameter="{Binding ReportID}"
                                                                Cursor="Hand"
                                                                Visibility="{Binding Status, Converter={StaticResource StringToAcceptButtonVisibilityConverter}}">
                                                                <TextBlock
                                                                    FontSize="18"
                                                                    Foreground="#10B981"
                                                                    Text="✔" />
                                                            </Button>

                                                            <!--  Отклонить (только если статус «На проверке»)  -->
                                                            <Button
                                                                Margin="5,0"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Click="RejectReport_Click"
                                                                CommandParameter="{Binding ReportID}"
                                                                Cursor="Hand"
                                                                Visibility="{Binding Status, Converter={StaticResource StringToRejectButtonVisibilityConverter}}">
                                                                <TextBlock
                                                                    FontSize="18"
                                                                    Foreground="#EF4444"
                                                                    Text="✖" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!--  Блок статистики  -->
                        <Border
                            Grid.Column="1"
                            Width="250"
                            Padding="20"
                            Background="{DynamicResource BackgroundColor3}"
                            CornerRadius="20">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="15"
                                    Opacity="1"
                                    ShadowDepth="0"
                                    Color="#010210" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Margin="0,0,0,20"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource ForegroundColor1}">
                                    Статистика
                                </TextBlock>

                                <Border
                                    Grid.Row="1"
                                    Margin="0,0,0,15"
                                    Padding="15"
                                    Background="#F0F5FF"
                                    CornerRadius="15">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="Всего отчетов" />
                                        <TextBlock
                                            x:Name="TxtTotalReports"
                                            FontSize="36"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource ForegroundColor1}"
                                            Text="0" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="2"
                                    Margin="0,0,0,15"
                                    Padding="15"
                                    Background="#F0F5FF"
                                    CornerRadius="15">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="Принято" />
                                        <TextBlock
                                            x:Name="TxtAcceptedReports"
                                            FontSize="36"
                                            FontWeight="Bold"
                                            Foreground="#10B981"
                                            Text="0" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="3"
                                    Margin="0,0,0,15"
                                    Padding="15"
                                    Background="#F0F5FF"
                                    CornerRadius="15">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="На проверке" />
                                        <TextBlock
                                            x:Name="TxtPendingReports"
                                            FontSize="36"
                                            FontWeight="Bold"
                                            Foreground="#F59E0B"
                                            Text="0" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="4"
                                    Margin="0,0,0,0"
                                    Padding="15"
                                    Background="#F0F5FF"
                                    CornerRadius="15">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="Отклонено" />
                                        <TextBlock
                                            x:Name="TxtRejectedReports"
                                            FontSize="36"
                                            FontWeight="Bold"
                                            Foreground="#EF4444"
                                            Text="0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>