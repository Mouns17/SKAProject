<Page x:Class="SKAProject.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Height="1080" Width="1520" FontFamily="Arian">
    <Grid Margin="0 60 0 0">
        <Border BorderBrush="{DynamicResource BackgroundColor6}" BorderThickness="1" CornerRadius="30" Background="{DynamicResource BackgroundColor2}" Padding="0" Margin="-5,0,-5,15">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="6"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <Grid Margin="40,30,40,50">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,32">
                        <TextBlock Text="Профиль" FontSize="40" FontWeight="SemiBold" 
                           Foreground="{DynamicResource ForegroundColor1}"/>
                        <TextBlock Text="Управление личной информацией и безопасностью" 
                           FontSize="30" Foreground="{DynamicResource ForegroundColor1}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- 1 -->
                    <StackPanel Grid.Row="1">
                        <Border Margin="500 0 500 20" Height="50" CornerRadius="30" Background="{DynamicResource BackgroundColor3}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" Color="#010210" Opacity="1" BlurRadius="15"/>
                            </Border.Effect>

                            <TextBlock Text="Основная информация" FontFamily="Arian Bold" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundColor1}"/>
                        </Border>
                        
                        <Border Margin="0 0 1230 0" Height="200" Width="200" CornerRadius="30" Background="{DynamicResource BackgroundColor3}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" Color="#010210" Opacity="1" BlurRadius="15"/>
                            </Border.Effect>

                            <TextBlock Text="👤" FontSize="100" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundColor1}"/>
                        </Border>

                        <Border CornerRadius="30" Margin="240 -200 0 0" Background="{DynamicResource BackgroundColor3}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" Color="#010210" Opacity="1" BlurRadius="15"/>
                            </Border.Effect>

                            <StackPanel>
                                <TextBlock x:Name="TBlockNames" Margin="20 35 200 100" Text="ФИО:" FontSize="45" FontFamily="Arian Bold" Foreground="{DynamicResource ForegroundColor1}"/>
                                <TextBlock x:Name="TBlockRole" Margin="20 -70 500 0" Text="Роль:" FontSize="45" FontFamily="Arian Bold" Foreground="{DynamicResource ForegroundColor1}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 2 -->
                    <StackPanel Grid.Row="2">
                        <Border Margin="500 40 500 20" Height="50" CornerRadius="30" Background="{DynamicResource BackgroundColor3}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" Color="#010210" Opacity="1" BlurRadius="15"/>
                            </Border.Effect>

                            <TextBlock Text="Личные данные" FontFamily="Arian Bold" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundColor1}"/>
                        </Border>

                        <Border Margin="1250 -100 0 -10" Height="50" CornerRadius="30" Background="{DynamicResource BackgroundColor3}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" Color="#010210" Opacity="1" BlurRadius="15"/>
                            </Border.Effect>

                            <TextBlock Text="Время" FontFamily="Arian Bold" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundColor1}"/>
                        </Border>

                        <Border Margin="0 0 200 20" Height="200" CornerRadius="30" Background="{DynamicResource BackgroundColor3}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" Color="#010210" Opacity="1" BlurRadius="15"/>
                            </Border.Effect>

                            <StackPanel>
                                <TextBlock x:Name="TBlockEmail" Margin="20 30 500 0" Text="Email:" FontSize="45" FontFamily="Arian Bold" Foreground="{DynamicResource ForegroundColor1}"/>
                                <TextBlock x:Name="TBlockPhone" Margin="20 30 500 0" Text="Телефон:" FontSize="45" FontFamily="Arian Bold" Foreground="{DynamicResource ForegroundColor1}"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="1250 -240 0 0" Height="200" CornerRadius="30" Background="{DynamicResource BackgroundColor3}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" Color="#010210" Opacity="1" BlurRadius="15"/>
                            </Border.Effect>

                            <StackPanel Margin="40 20 40 20">
                                <TextBlock x:Name="TBlockTime" Margin="0 50 0 0" TextWrapping="Wrap" FontSize="60" FontFamily="Arian Bold" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundColor1}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 3 -->
                    <StackPanel Grid.Row="3">
                        <Border Margin="500 20 500 20" Height="50" CornerRadius="30" Background="{DynamicResource BackgroundColor3}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" Color="#010210" Opacity="1" BlurRadius="15"/>
                            </Border.Effect>

                            <TextBlock Text="Рабочие данные" FontFamily="Arian Bold" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundColor1}"/>
                        </Border>

                        <Border Margin="0 0 0 20" Height="270" CornerRadius="30" Background="{DynamicResource BackgroundColor3}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" Color="#010210" Opacity="1" BlurRadius="15"/>
                            </Border.Effect>

                            <StackPanel>
                                <TextBlock x:Name="TBlockDep" Margin="20 30 500 0" Text="Отдел:" FontSize="45" FontFamily="Arian Bold" Foreground="{DynamicResource ForegroundColor1}"/>
                                <TextBlock x:Name="TBlockPost" Margin="20 30 500 0" Text="Должность:" FontSize="45" FontFamily="Arian Bold" Foreground="{DynamicResource ForegroundColor1}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Кнопки действий -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,0" HorizontalAlignment="Center">
                        <Button Height="60" Width="180" Margin="0,40,20,0" Background="#6366F1" Cursor="Hand" FontWeight="SemiBold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✏️" Margin="0,0,8,0" Foreground="White" FontSize="18"/>
                                <TextBlock Text="Редактировать" Foreground="White" FontSize="18"/>
                            </StackPanel>
                        </Button>

                        <Button Height="60" Width="180" Background="#1A1A1A" BorderBrush="#2A2A2A"  BorderThickness="1" Cursor="Hand" Margin="0,40,20,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔒" Margin="0,0,8,0" Foreground="White" FontSize="18"/>
                                <TextBlock Text="Сменить пароль" Foreground="White" FontSize="18"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>