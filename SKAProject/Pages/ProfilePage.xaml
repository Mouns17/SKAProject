<Page
    x:Class="SKAProject.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ProfilePage"
    Background="{DynamicResource ContentBackgroundBrush}"
    FontFamily="Arian">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Описание  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock
                FontSize="36"
                FontWeight="SemiBold"
                Foreground="{DynamicResource ForegroundColor1}"
                Text="Профиль" />
            <TextBlock
                Margin="0,8,0,0"
                FontSize="22"
                Foreground="{DynamicResource ForegroundColor1}"
                Text="Управление личной информацией и безопасностью" />
        </StackPanel>

        <!--  Карточки с информацией  -->
        <StackPanel Grid.Row="1" Margin="10,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Аватарка  -->
                <Border
                    Grid.Column="0"
                    Width="140"
                    Height="140"
                    Margin="0,0,15,0"
                    Background="{DynamicResource BackgroundColor3}"
                    CornerRadius="75">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="15"
                            Opacity="0.8"
                            ShadowDepth="0"
                            Color="#010210" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock
                            Margin="5,25,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="80"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="👤" />
                    </StackPanel>
                </Border>

                <!--  Основная информация  -->
                <Border
                    Grid.Column="1"
                    Margin="0,0,15,0"
                    Padding="20"
                    Background="{DynamicResource BackgroundColor3}"
                    CornerRadius="20">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="15"
                            Opacity="0.8"
                            ShadowDepth="0"
                            Color="#010210" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock
                            FontSize="23"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Основная информация:" />

                        <TextBlock
                            x:Name="TBlockNames"
                            Margin="10,20,550,20"
                            FontFamily="Arian Bold"
                            FontSize="20"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="ФИО:" />

                        <!--  Редактирование ФИО  -->
                        <StackPanel
                            x:Name="PanelEditFullName"
                            Margin="20,20,200,0"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                            <TextBox
                                x:Name="TBoxLastName"
                                Width="180"
                                FontFamily="Arian"
                                FontSize="25"
                                Style="{DynamicResource TxtBoxStyle}"
                                Tag="Фамилия" />
                            <TextBox
                                x:Name="TBoxFirstName"
                                Width="180"
                                Margin="10,0,0,0"
                                FontFamily="Arian"
                                FontSize="25"
                                Style="{DynamicResource TxtBoxStyle}"
                                Tag="Имя" />
                            <TextBox
                                x:Name="TBoxMiddleName"
                                Width="180"
                                Margin="10,0,0,0"
                                FontFamily="Arian"
                                FontSize="25"
                                Style="{DynamicResource TxtBoxStyle}"
                                Tag="Отчество" />
                        </StackPanel>

                        <!--  Роль (не редактируется)  -->
                        <TextBlock
                            x:Name="TBlockRole"
                            Margin="10,0,550,0"
                            FontFamily="Arian Bold"
                            FontSize="20"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Роль:" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <!--  Табельный номер (не редактируется)  -->
            <TextBlock
                x:Name="TBlockEmployeeId"
                Margin="10,0,500,0"
                FontFamily="Arian Bold"
                FontSize="15"
                Foreground="{DynamicResource ForegroundColor1}"
                Text="Таб. №:" />
            <!--  Статус (цветной бейдж)  -->
            <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="Arian Bold"
                    FontSize="15"
                    Foreground="{DynamicResource ForegroundColor1}"
                    Text="Статус:" />
                <Border
                    x:Name="StatusBadge"
                    Margin="15,0,0,0"
                    Padding="10,2"
                    VerticalAlignment="Center"
                    Background="Gray"
                    CornerRadius="10">
                    <TextBlock
                        x:Name="TxtStatus"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Работает" />
                </Border>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="10,10,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Margin="0,0,15,0"
                    Padding="20"
                    Background="{DynamicResource BackgroundColor3}"
                    CornerRadius="20">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="15"
                            Opacity="0.8"
                            ShadowDepth="0"
                            Color="#010210" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock
                            FontSize="23"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Контактные данные:" />

                        <TextBlock
                            x:Name="TBlockPhone"
                            Margin="10,20,0,20"
                            FontFamily="Arian Bold"
                            FontSize="20"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Телефон:" />
                        <TextBox
                            x:Name="TBoxPhone"
                            Width="230"
                            Margin="0,0,0,0"
                            FontFamily="Arian"
                            FontSize="17"
                            Style="{DynamicResource TxtBoxStyle}"
                            Tag="Телефон"
                            Visibility="Collapsed" />

                        <TextBlock
                            x:Name="TBlockEmail"
                            Margin="10,0,0,0"
                            FontFamily="Arian Bold"
                            FontSize="20"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Email:" />
                        <TextBox
                            x:Name="TBoxEmail"
                            Width="260"
                            Margin="0,5,0,0"
                            FontFamily="Arian"
                            FontSize="17"
                            Style="{DynamicResource TxtBoxStyle}"
                            Tag="Email"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Margin="0,0,15,0"
                    Padding="20"
                    Background="{DynamicResource BackgroundColor3}"
                    CornerRadius="20">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="15"
                            Opacity="0.8"
                            ShadowDepth="0"
                            Color="#010210" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock
                            FontSize="23"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Личные данные:" />

                        <TextBlock
                            x:Name="TBlockSnils"
                            Margin="10,20,0,20"
                            FontFamily="Arian Bold"
                            FontSize="20"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="СНИЛС:" />

                        <TextBlock
                            x:Name="TBlockAddress"
                            Margin="10,0,0,0"
                            FontFamily="Arian Bold"
                            FontSize="20"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Адрес:" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="10,10,0,10">
            <Grid>
                <Border
                    Margin="0,0,15,0"
                    Padding="20"
                    Background="{DynamicResource BackgroundColor3}"
                    CornerRadius="20">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="15"
                            Opacity="0.8"
                            ShadowDepth="0"
                            Color="#010210" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock
                            FontSize="23"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Рабочие данные:" />

                        <TextBlock
                            x:Name="TBlockDep"
                            Margin="10,20,0,20"
                            FontFamily="Arian Bold"
                            FontSize="20"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Отдел:" />

                        <TextBlock
                            x:Name="TBlockPost"
                            Margin="10,0,0,0"
                            FontFamily="Arian Bold"
                            FontSize="20"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Должность:" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!--  Кнопки действий  -->
        <StackPanel
            Grid.Row="5"
            Margin="0,0,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                x:Name="BtnEdit"
                Width="180"
                Height="50"
                Margin="0,10,0,0"
                Background="#6366F1"
                BorderThickness="0"
                Click="BtnEdit_Click"
                Cursor="Hand"
                FontWeight="SemiBold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        FontSize="18"
                        Foreground="White"
                        Text="✏️" />
                    <TextBlock
                        FontSize="18"
                        Foreground="White"
                        Text="Редактировать" />
                </StackPanel>
            </Button>

            <Button
                x:Name="BtnSave"
                Width="180"
                Height="60"
                Margin="0,40,20,0"
                Background="#10B981"
                BorderThickness="0"
                Click="BtnSave_Click"
                Cursor="Hand"
                FontWeight="SemiBold"
                Visibility="Collapsed">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        FontSize="18"
                        Foreground="White"
                        Text="💾" />
                    <TextBlock
                        FontSize="18"
                        Foreground="White"
                        Text="Сохранить" />
                </StackPanel>
            </Button>

            <Button
                x:Name="BtnCancel"
                Width="180"
                Height="60"
                Margin="0,40,20,0"
                Background="#6B7280"
                BorderThickness="0"
                Click="BtnCancel_Click"
                Cursor="Hand"
                FontWeight="SemiBold"
                Visibility="Collapsed">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        FontSize="18"
                        Foreground="White"
                        Text="↩" />
                    <TextBlock
                        FontSize="18"
                        Foreground="White"
                        Text="Отмена" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>