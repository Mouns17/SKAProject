<Page
    x:Class="SKAProject.Pages.PayrollPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Расчёт зарплаты"
    Background="{DynamicResource ContentBackgroundBrush}"
    FontFamily="Arian">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,20"
            FontSize="36"
            FontWeight="SemiBold"
            Foreground="{DynamicResource ForegroundColor1}"
            Text="Расчёт заработной платы" />
        <TextBlock
            Grid.Row="1"
            Margin="0,0,0,25"
            FontSize="22"
            Foreground="{DynamicResource ForegroundColor1}"
            Text="Автоматический расчёт по окладам за выбранный период" />

        <StackPanel
            Grid.Row="2"
            Margin="0,0,0,15"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{DynamicResource ForegroundColor1}"
                Text="Период:" />
            <ComboBox
                x:Name="CmbMonth"
                Width="150"
                Height="35"
                Margin="0,0,20,0"
                FontSize="16"
                SelectedIndex="0" />
            <Button
                x:Name="BtnCalculate"
                Width="160"
                Height="40"
                Background="{DynamicResource BackgroundColor6}"
                BorderThickness="0"
                Click="BtnCalculate_Click"
                Content="Рассчитать"
                Cursor="Hand"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <Border
            Grid.Row="3"
            Background="{DynamicResource BackgroundColor3}"
            CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    Opacity="0.8"
                    ShadowDepth="0"
                    Color="#010210" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Padding="10,5"
                    Background="#F0F5FF"
                    BorderBrush="#D0D9E8"
                    BorderThickness="0,0,0,2"
                    CornerRadius="20 20 0 0">
                    <Grid Height="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#4A5568"
                            Text="№" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#4A5568"
                            Text="Сотрудник" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#4A5568"
                            Text="Оклад" />
                        <TextBlock
                            Grid.Column="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#4A5568"
                            Text="Надбавка" />
                        <TextBlock
                            Grid.Column="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#4A5568"
                            Text="НДФЛ (13%)" />
                        <TextBlock
                            Grid.Column="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#4A5568"
                            Text="К выдаче" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PayrollItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="5"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="0,0,0,1">
                                    <Grid Height="45">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="#4A5568"
                                            Text="{Binding RowNumber}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="10,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="#2D3748"
                                            Text="{Binding EmployeeFullName}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="#4A5568"
                                            Text="{Binding Salary}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="#4A5568"
                                            Text="{Binding Bonus}" />
                                        <TextBlock
                                            Grid.Column="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="#EF4444"
                                            Text="{Binding Tax}" />
                                        <TextBlock
                                            Grid.Column="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="#10B981"
                                            Text="{Binding NetPay}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>