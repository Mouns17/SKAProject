<Page
    x:Class="SKAProject.Pages.MyTasks"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WorkersPage"
    Width="1520"
    Height="1080"
    FontFamily="Arian">
    <Grid Margin="0,60,0,0">
        <Border
            Margin="-5,0,-5,15"
            Padding="0"
            Background="#EDF4FF"
            BorderBrush="{DynamicResource BackgroundColor6}"
            BorderThickness="1"
            CornerRadius="30">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="6" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid>
                                        <Border Background="Transparent" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <Grid Margin="40,30,40,50">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Заголовок и панель управления  -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,32">
                        <TextBlock
                            FontSize="40"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Мои задачи" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="30"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Ваши персональные задачи и назначения" />
                    </StackPanel>

                    <!--  Панель инструментов (поиск, фильтр, кнопки)  -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <!--  Верхняя строка: Поиск и кнопки  -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Поисковая строка  -->
                            <Border
                                Grid.Column="0"
                                Height="55"
                                Margin="0,0,0,0"
                                Background="{DynamicResource BackgroundColor3}"
                                BorderBrush="{DynamicResource BackgroundColor6}"
                                BorderThickness="1"
                                CornerRadius="15">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="15"
                                        Opacity="0.8"
                                        ShadowDepth="0"
                                        Color="#010210" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="20,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Foreground="{DynamicResource ForegroundColor1}"
                                        Text="🔍" />
                                    <TextBox
                                        x:Name="SearchTextBox"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontFamily="Arian"
                                        FontSize="18"
                                        Foreground="{DynamicResource ForegroundColor1}" />
                                    <TextBlock
                                        x:Name="SearchPlaceholder"
                                        Grid.Column="1"
                                        Margin="2,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Arian"
                                        FontSize="18"
                                        Foreground="#8899AA"
                                        IsHitTestVisible="False"
                                        Text="Поиск по номеру, приоритету, статусу..." />
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!--  Таблица сотрудников в стиле логов  -->
                    <Border
                        Grid.Row="2"
                        Margin="0,0,400,0"
                        Background="{DynamicResource BackgroundColor3}"
                        CornerRadius="20">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="15"
                                Opacity="1"
                                ShadowDepth="0"
                                Color="#010210" />
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Заголовок таблицы  -->
                            <Border
                                Grid.Row="0"
                                Background="#F0F5FF"
                                BorderBrush="#D0D9E8"
                                BorderThickness="0,0,0,2"
                                CornerRadius="20 20 0 0">
                                <Grid Height="60">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="270" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#4A5568"
                                        Text="№" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#4A5568"
                                        Text="От кого" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#4A5568"
                                        Text="Дата выдачи" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#4A5568"
                                        Text="Дата окончания" />
                                    <TextBlock
                                        Grid.Column="5"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#4A5568"
                                        Text="Приоритет" />
                                    <TextBlock
                                        Grid.Column="6"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#4A5568"
                                        Text="Краткое описание" />
                                </Grid>
                            </Border>

                            <!--  Список сотрудников  -->
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Width" Value="6" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </ScrollViewer.Resources>

                                <ItemsControl x:Name="WorkersItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Background="Transparent"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="0,0,0,1">
                                                <Grid Height="65">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="200" />
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="250" />
                                                        <ColumnDefinition Width="200" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="50" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox
                                                        Grid.Column="0"
                                                        Margin="15,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Cursor="Hand"
                                                        IsChecked="{Binding IsSelected}" />

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Orientation="Vertical">
                                                        <TextBlock
                                                            FontSize="16"
                                                            FontWeight="SemiBold"
                                                            Foreground="#2D3748"
                                                            Text="{Binding FullName}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="#A0AEC0"
                                                            Text="{Binding WorkerId}" />
                                                    </StackPanel>

                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="#4A5568"
                                                        Text="{Binding Department}" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="#4A5568"
                                                        Text="{Binding Position}" />
                                                    <TextBlock
                                                        Grid.Column="4"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="#4A5568"
                                                        Text="{Binding Phone}" />
                                                    <TextBlock
                                                        Grid.Column="5"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="#4A5568"
                                                        Text="{Binding Email}" />

                                                    <!--  Статус с цветовой индикацией  -->
                                                    <Border
                                                        Grid.Column="6"
                                                        Margin="10,0,0,0"
                                                        Padding="10,5"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding StatusColor}"
                                                        CornerRadius="20">
                                                        <TextBlock
                                                            FontSize="14"
                                                            FontWeight="SemiBold"
                                                            Foreground="White"
                                                            Text="{Binding Status}" />
                                                    </Border>

                                                    <!--  Кнопки действий  -->
                                                    <StackPanel
                                                        Grid.Column="7"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <Button
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            CommandParameter="{Binding WorkerId}"
                                                            Cursor="Hand">
                                                            <TextBlock FontSize="18" Text="✏️" />
                                                        </Button>
                                                        <Button
                                                            Margin="10,0,0,0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            CommandParameter="{Binding WorkerId}"
                                                            Cursor="Hand">
                                                            <TextBlock FontSize="18" Text="🗑️" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Button
                        Width="360"
                        Margin="1070,0,0,-337"
                        Click="ReportCreate_Click"
                        Content="Отправить отчёт"
                        Style="{DynamicResource TaskBtnStyle}" />

                    <Border
                        Grid.Row="2"
                        Margin="1070,70,0,0"
                        Background="{DynamicResource BackgroundColor3}"
                        CornerRadius="20">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="15"
                                Opacity="1"
                                ShadowDepth="0"
                                Color="#010210" />
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="230" />
                                <RowDefinition Height="230" />
                                <RowDefinition Height="230" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Margin="20,20,20,10"
                                HorizontalAlignment="Center"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#4A5568"
                                Text="Всего задач" />
                            <TextBlock
                                Grid.Row="1"
                                Margin="20,20,20,10"
                                HorizontalAlignment="Center"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#4A5568"
                                Text="Завершенных задач" />
                            <TextBlock
                                Grid.Row="2"
                                Margin="20,20,20,10"
                                HorizontalAlignment="Center"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#4A5568"
                                Text="Незавершенных задач" />
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>