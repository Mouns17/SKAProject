<Page x:Class="SKAProject.Pages.MyTasks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="MyTasksPage"
      Background="#0A0A0A" FontFamily="Arian">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,30,40,50">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="0,0,0,32">
                <TextBlock Text="Мои задачи" FontSize="34" FontWeight="SemiBold" 
                           Foreground="#FFFFFF"/>
                <TextBlock Text="Ваши персональные задачи и назначения" 
                           FontSize="14" Foreground="#888888" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Баннер с прогрессом -->
            <Border Grid.Row="1" Height="140" CornerRadius="20" Margin="0,0,0,32">
                <Border.Background>
                    <LinearGradientBrush EndPoint="1,1">
                        <GradientStop Color="#6366F1" Offset="0"/>
                        <GradientStop Color="#8B5CF6" Offset="0.5"/>
                        <GradientStop Color="#EC4899" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Margin="30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="8" FontSize="32" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Активных задач" FontSize="12" Foreground="#E0E0E0" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="4" FontSize="32" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Выполнено" FontSize="12" Foreground="#E0E0E0" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="75%" FontSize="32" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Общий прогресс" FontSize="12" Foreground="#E0E0E0" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Фильтры -->
            <Border Grid.Row="2" Background="#121212" CornerRadius="20" 
                    Padding="20" Margin="0,0,0,24" BorderBrush="#1E1E1E" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Button Background="Transparent" BorderBrush="#2A2A2A" BorderThickness="1" 
                            Padding="12,8" Margin="0,0,10,0" Cursor="Hand">
                        <TextBlock Text="Все задачи" Foreground="White" FontSize="13"/>
                    </Button>
                    <Button Background="#6366F1" Padding="12,8" Margin="0,0,10,0" Cursor="Hand">
                        <TextBlock Text="Активные" Foreground="White" FontSize="13"/>
                    </Button>
                    <Button Background="Transparent" BorderBrush="#2A2A2A" BorderThickness="1" 
                            Padding="12,8" Margin="0,0,10,0" Cursor="Hand">
                        <TextBlock Text="Завершённые" Foreground="White" FontSize="13"/>
                    </Button>
                    <Button Background="Transparent" BorderBrush="#2A2A2A" BorderThickness="1" 
                            Padding="12,8" Cursor="Hand">
                        <TextBlock Text="Просроченные" Foreground="White" FontSize="13"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Список задач -->
            <StackPanel Grid.Row="3" Margin="0,0,0,20">

                <!-- Задача 1 -->
                <Border Background="#121212" CornerRadius="16" Padding="20" Margin="0,0,0,12" 
                        BorderBrush="#1E1E1E" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" Width="22" Height="22" Margin="0,0,15,0" VerticalAlignment="Center">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#1A1A1A" 
                                            BorderBrush="#2A2A2A" BorderThickness="1">
                                        <TextBlock x:Name="CheckMark" Text="✓" Foreground="#6366F1" 
                                                   FontSize="14" HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Подготовить отчёт за март" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Собрать статистику и подготовить аналитический отчёт" 
                                       FontSize="13" Foreground="#888888" Margin="0,5,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="📅 31.03.2025" FontSize="12" Foreground="#666666"/>
                                <TextBlock Text="⭐ Высокий приоритет" FontSize="12" Foreground="#EC4899" Margin="15,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2" Width="80" Height="32" Background="#1A1A1A" 
                                Cursor="Hand" Margin="10,0,0,0"
                                BorderBrush="#2A2A2A" BorderThickness="1">
                            <TextBlock Text="Детали" Foreground="#6366F1" FontSize="12"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Задача 2 -->
                <Border Background="#121212" CornerRadius="16" Padding="20" Margin="0,0,0,12" 
                        BorderBrush="#1E1E1E" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" Width="22" Height="22" Margin="0,0,15,0" VerticalAlignment="Center">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#1A1A1A" 
                                            BorderBrush="#2A2A2A" BorderThickness="1">
                                        <TextBlock x:Name="CheckMark" Text="✓" Foreground="#6366F1" 
                                                   FontSize="14" HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Провести встречу с командой" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Обсудить результаты первого квартала" 
                                       FontSize="13" Foreground="#888888" Margin="0,5,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="📅 28.03.2025" FontSize="12" Foreground="#666666"/>
                                <TextBlock Text="⭐ Средний приоритет" FontSize="12" Foreground="#F59E0B" Margin="15,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2" Width="80" Height="32" Background="#1A1A1A" 
                                Cursor="Hand" Margin="10,0,0,0"
                                BorderBrush="#2A2A2A" BorderThickness="1">
                            <TextBlock Text="Детали" Foreground="#6366F1" FontSize="12"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Задача 3 -->
                <Border Background="#121212" CornerRadius="16" Padding="20" Margin="0,0,0,12" 
                        BorderBrush="#1E1E1E" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" Width="22" Height="22" Margin="0,0,15,0" VerticalAlignment="Center" IsChecked="True">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#1A1A1A" 
                                            BorderBrush="#2A2A2A" BorderThickness="1">
                                        <TextBlock x:Name="CheckMark" Text="✓" Foreground="#6366F1" 
                                                   FontSize="14" HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Обновить документацию" FontSize="16" FontWeight="SemiBold" Foreground="#888888" 
                                       TextDecorations="Strikethrough"/>
                            <TextBlock Text="Обновить техническую документацию проекта" 
                                       FontSize="13" Foreground="#666666" Margin="0,5,0,0" 
                                       TextDecorations="Strikethrough"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="✅ Завершено 20.03.2025" FontSize="12" Foreground="#10B981"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2" Width="80" Height="32" Background="#1A1A1A" 
                                Cursor="Hand" Margin="10,0,0,0"
                                BorderBrush="#2A2A2A" BorderThickness="1">
                            <TextBlock Text="Детали" Foreground="#888888" FontSize="12"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Задача 4 -->
                <Border Background="#121212" CornerRadius="16" Padding="20" Margin="0,0,0,12" 
                        BorderBrush="#1E1E1E" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" Width="22" Height="22" Margin="0,0,15,0" VerticalAlignment="Center">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#1A1A1A" 
                                            BorderBrush="#2A2A2A" BorderThickness="1">
                                        <TextBlock x:Name="CheckMark" Text="✓" Foreground="#6366F1" 
                                                   FontSize="14" HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Подготовить презентацию для совета" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Подготовить материалы для ежеквартального совета директоров" 
                                       FontSize="13" Foreground="#888888" Margin="0,5,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="📅 05.04.2025" FontSize="12" Foreground="#666666"/>
                                <TextBlock Text="⭐ Высокий приоритет" FontSize="12" Foreground="#EC4899" Margin="15,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2" Width="80" Height="32" Background="#1A1A1A" 
                                Cursor="Hand" Margin="10,0,0,0"
                                BorderBrush="#2A2A2A" BorderThickness="1">
                            <TextBlock Text="Детали" Foreground="#6366F1" FontSize="12"/>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>