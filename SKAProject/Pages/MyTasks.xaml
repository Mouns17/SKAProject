<Page
    x:Class="SKAProject.Pages.MyTasks"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MyTasks"
    Width="1520"
    Height="1080"
    FontFamily="Arian">
    <Grid Margin="0,60,0,0">
        <Border
            Margin="-5,0,-5,15"
            Padding="0"
            Background="#EDF4FF"
            BorderBrush="{DynamicResource BackgroundColor6}"
            BorderThickness="1"
            CornerRadius="30">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="6" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid>
                                        <Border Background="Transparent" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <Grid Margin="40,30,40,50">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Заголовок  -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,32">
                        <TextBlock
                            FontSize="40"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Мои задачи" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="30"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Ваши персональные задачи и назначения" />
                    </StackPanel>

                    <!--  Поиск и фильтры  -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Поисковая строка  -->
                            <Border
                                Grid.Column="0"
                                Height="55"
                                Margin="0,0,20,0"
                                Background="{DynamicResource BackgroundColor3}"
                                BorderBrush="{DynamicResource BackgroundColor6}"
                                BorderThickness="1"
                                CornerRadius="15">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="15"
                                        Opacity="0.8"
                                        ShadowDepth="0"
                                        Color="#010210" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="20,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Foreground="{DynamicResource ForegroundColor1}"
                                        Text="🔍" />
                                    <TextBox
                                        x:Name="SearchTextBox"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontFamily="Arian"
                                        FontSize="18"
                                        Foreground="{DynamicResource ForegroundColor1}" />
                                    <TextBlock
                                        x:Name="SearchPlaceholder"
                                        Grid.Column="1"
                                        Margin="2,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Arian"
                                        FontSize="18"
                                        Foreground="#8899AA"
                                        IsHitTestVisible="False"
                                        Text="Поиск по номеру, приоритету, статусу..." />
                                </Grid>
                            </Border>

                            <!--  Кнопка Отправить отчёт  -->
                            <Button
                                Grid.Column="1"
                                Width="200"
                                Height="55"
                                Background="#6366F1"
                                Click="ReportCreate_Click"
                                Cursor="Hand"
                                FontWeight="SemiBold">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="15"
                                                    Opacity="0.4"
                                                    ShadowDepth="0"
                                                    Color="#6366F1" />
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontSize="15"
                                        Foreground="White"
                                        Text="📋" />
                                    <TextBlock
                                        FontSize="15"
                                        Foreground="White"
                                        Text="Отправить отчёт" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!--  Таблица задач и статистика  -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Таблица задач  -->
                        <Border
                            Grid.Column="0"
                            Margin="0,0,20,0"
                            Background="{DynamicResource BackgroundColor3}"
                            CornerRadius="20">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="15"
                                    Opacity="1"
                                    ShadowDepth="0"
                                    Color="#010210" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  Заголовок таблицы  -->
                                <Border
                                    Grid.Row="0"
                                    Background="#F0F5FF"
                                    BorderBrush="#D0D9E8"
                                    BorderThickness="0,0,0,2"
                                    CornerRadius="20 20 0 0">
                                    <Grid Height="60">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <!--  №  -->
                                            <ColumnDefinition Width="220" />
                                            <!--  От кого  -->
                                            <ColumnDefinition Width="160" />
                                            <!--  Дата выдачи  -->
                                            <ColumnDefinition Width="160" />
                                            <!--  Дата окончания  -->
                                            <ColumnDefinition Width="150" />
                                            <!--  Приоритет  -->
                                            <ColumnDefinition Width="*" />
                                            <!--  Краткое описание  -->
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="№" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="От кого" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="Дата выдачи" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="Дата окончания" />
                                        <TextBlock
                                            Grid.Column="4"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="Приоритет" />
                                        <TextBlock
                                            Grid.Column="5"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="Краткое описание" />
                                    </Grid>
                                </Border>

                                <!--  Список задач  -->
                                <ScrollViewer
                                    Grid.Row="1"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar">
                                            <Setter Property="Width" Value="6" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </ScrollViewer.Resources>

                                    <ItemsControl x:Name="TasksItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Background="Transparent"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="0,0,0,1">
                                                    <Grid Height="65">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="220" />
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Margin="10,0,0,0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Foreground="#4A5568"
                                                            Text="{Binding TaskId}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="10,0,0,0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            FontWeight="SemiBold"
                                                            Foreground="#2D3748"
                                                            Text="{Binding CreatedByName}" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Margin="10,0,0,0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Foreground="#4A5568"
                                                            Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy'}" />
                                                        <TextBlock
                                                            Grid.Column="3"
                                                            Margin="10,0,0,0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Foreground="#4A5568"
                                                            Text="{Binding Deadline, StringFormat='dd.MM.yyyy'}" />
                                                        <TextBlock
                                                            Grid.Column="4"
                                                            Margin="10,0,0,0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Foreground="#4A5568"
                                                            Text="{Binding Priority}" />
                                                        <TextBlock
                                                            Grid.Column="5"
                                                            Margin="10,0,0,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Foreground="#4A5568"
                                                            Text="{Binding Title}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!--  Статистика  -->
                        <Border
                            Grid.Column="1"
                            Width="380"
                            Padding="20"
                            Background="{DynamicResource BackgroundColor3}"
                            CornerRadius="20">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="15"
                                    Opacity="1"
                                    ShadowDepth="0"
                                    Color="#010210" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Margin="0,0,0,20"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource ForegroundColor1}">
                                    Статистика
                                </TextBlock>

                                <Border
                                    Grid.Row="1"
                                    Margin="0,0,0,15"
                                    Padding="15"
                                    Background="#F0F5FF"
                                    CornerRadius="15">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="Всего задач" />
                                        <TextBlock
                                            x:Name="TxtTotalTasks"
                                            FontSize="36"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource ForegroundColor1}"
                                            Text="0" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="2"
                                    Margin="0,0,0,15"
                                    Padding="15"
                                    Background="#F0F5FF"
                                    CornerRadius="15">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="Завершенных задач" />
                                        <TextBlock
                                            x:Name="TxtCompletedTasks"
                                            FontSize="36"
                                            FontWeight="Bold"
                                            Foreground="#10B981"
                                            Text="0" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="3"
                                    Margin="0,0,0,0"
                                    Padding="15"
                                    Background="#F0F5FF"
                                    CornerRadius="15">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#4A5568"
                                            Text="Незавершенных задач" />
                                        <TextBlock
                                            x:Name="TxtPendingTasks"
                                            FontSize="36"
                                            FontWeight="Bold"
                                            Foreground="#F59E0B"
                                            Text="0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>