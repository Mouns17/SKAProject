<Page
    x:Class="SKAProject.Pages.MyTasks"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Мои задачи"
    Background="{DynamicResource ContentBackgroundBrush}"
    FontFamily="Arian">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Заголовок  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock
                FontSize="36"
                FontWeight="SemiBold"
                Foreground="{DynamicResource ForegroundColor1}"
                Text="Мои задачи" />
            <TextBlock
                Margin="0,8,0,0"
                FontSize="22"
                Foreground="{DynamicResource ForegroundColor1}"
                Text="Ваши персональные задачи и назначения" />
        </StackPanel>

        <!--  Поиск и кнопка  -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                Height="55"
                Margin="0,0,20,0"
                Background="{DynamicResource BackgroundColor3}"
                BorderBrush="{DynamicResource BackgroundColor6}"
                BorderThickness="1"
                CornerRadius="15">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="15"
                        Opacity="0.8"
                        ShadowDepth="0"
                        Color="#010210" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="20,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{DynamicResource ForegroundColor1}"
                        Text="🔍" />
                    <TextBox
                        x:Name="SearchTextBox"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="Arian"
                        FontSize="18"
                        Foreground="{DynamicResource ForegroundColor1}" />
                    <TextBlock
                        x:Name="SearchPlaceholder"
                        Grid.Column="1"
                        Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="Arian"
                        FontSize="18"
                        Foreground="#8899AA"
                        IsHitTestVisible="False"
                        Text="Поиск по номеру, приоритету, статусу..." />
                </Grid>
            </Border>
            <Button
                Grid.Column="1"
                Width="200"
                Height="55"
                Background="{DynamicResource BackgroundColor6}"
                BorderThickness="0"
                Click="ReportCreate_Click"
                Cursor="Hand"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        FontSize="18"
                        Text="📄" />
                    <TextBlock Text="Отправить отчёт" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  Таблица задач + статистика  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="0,0,20,0"
                Background="{DynamicResource BackgroundColor3}"
                CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="15"
                        Opacity="1"
                        ShadowDepth="0"
                        Color="#010210" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        Background="#F0F5FF"
                        BorderBrush="#D0D9E8"
                        BorderThickness="0,0,0,2"
                        CornerRadius="20 20 0 0">
                        <Grid Height="50">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#4A5568"
                                Text="№" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#4A5568"
                                Text="От кого" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#4A5568"
                                Text="Дата выдачи" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#4A5568"
                                Text="Дата окончания" />
                            <TextBlock
                                Grid.Column="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#4A5568"
                                Text="Приоритет" />
                            <TextBlock
                                Grid.Column="5"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#4A5568"
                                Text="Краткое описание" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TasksItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="Transparent"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="0,0,0,1">
                                        <Grid Height="50">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="#4A5568"
                                                Text="{Binding TaskId}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="#2D3748"
                                                Text="{Binding CreatedByName}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="#4A5568"
                                                Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy'}" />
                                            <TextBlock
                                                Grid.Column="3"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="#4A5568"
                                                Text="{Binding Deadline, StringFormat='dd.MM.yyyy'}" />
                                            <TextBlock
                                                Grid.Column="4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="#4A5568"
                                                Text="{Binding Priority}" />
                                            <TextBlock
                                                Grid.Column="5"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="#4A5568"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Button
                                                Grid.Column="6"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="CompleteTask_Click"
                                                CommandParameter="{Binding TaskId}"
                                                Content="✔"
                                                Cursor="Hand"
                                                FontSize="18"
                                                Foreground="#10B981"
                                                ToolTip="Завершить задачу" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  Статистика  -->
            <Border
                Grid.Column="1"
                Width="380"
                Padding="20"
                Background="{DynamicResource BackgroundColor3}"
                CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="15"
                        Opacity="1"
                        ShadowDepth="0"
                        Color="#010210" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,20"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ForegroundColor1}">
                        Статистика
                    </TextBlock>
                    <Border
                        Grid.Row="1"
                        Margin="0,0,0,15"
                        Padding="15"
                        Background="#F0F5FF"
                        CornerRadius="15">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#4A5568"
                                Text="Всего задач" />
                            <TextBlock
                                x:Name="TxtTotalTasks"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="{DynamicResource ForegroundColor1}"
                                Text="0" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Row="2"
                        Margin="0,0,0,15"
                        Padding="15"
                        Background="#F0F5FF"
                        CornerRadius="15">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#4A5568"
                                Text="Завершенных задач" />
                            <TextBlock
                                x:Name="TxtCompletedTasks"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="#10B981"
                                Text="0" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Row="3"
                        Margin="0,0,0,0"
                        Padding="15"
                        Background="#F0F5FF"
                        CornerRadius="15">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#4A5568"
                                Text="Незавершенных задач" />
                            <TextBlock
                                x:Name="TxtPendingTasks"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="#F59E0B"
                                Text="0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>