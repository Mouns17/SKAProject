<Page x:Class="SKAProject.Pages.MyOrganizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="OrganizationPage"
      Background="#0A0A0A" FontFamily="Arian">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,30,40,50">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="0,0,0,32">
                <TextBlock Text="Моя организация" FontSize="34" FontWeight="SemiBold" 
                           Foreground="#FFFFFF"/>
                <TextBlock Text="Информация о компании и структура управления" 
                           FontSize="14" Foreground="#888888" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Баннер организации -->
            <Border Grid.Row="1" Height="160" CornerRadius="20" Margin="0,0,0,32">
                <Border.Background>
                    <LinearGradientBrush EndPoint="1,1">
                        <GradientStop Color="#6366F1" Offset="0"/>
                        <GradientStop Color="#8B5CF6" Offset="0.5"/>
                        <GradientStop Color="#EC4899" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Margin="30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="80" Height="80" CornerRadius="20" 
                            Background="White" Opacity="0.2">
                        <TextBlock Text="🏢" FontSize="40" HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ООО &quot;Системы Контроля и Анализа&quot;" 
                                   FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="СКА · ИНН: 7701234567" FontSize="14" Foreground="#E0E0E0" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Основная информация -->
            <Border Grid.Row="2" Background="#121212" CornerRadius="20" 
                    Padding="24" Margin="0,0,0,24" BorderBrush="#1E1E1E" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📋 Основная информация" FontSize="18" FontWeight="SemiBold" 
                               Foreground="White" Margin="0,0,0,20"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Полное наименование" Foreground="#888888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="ООО &quot;Системы Контроля и Анализа&quot;" Foreground="White" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Краткое наименование" Foreground="#888888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="ООО &quot;СКА&quot;" Foreground="White" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="ИНН / КПП" Foreground="#888888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="7701234567 / 770101001" Foreground="White" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="ОГРН" Foreground="#888888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="1237700123456" Foreground="White" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Генеральный директор" Foreground="#888888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Смирнов Александр Владимирович" Foreground="White" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Количество сотрудников" Foreground="#888888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="127 человек" Foreground="White" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Юридический адрес" Foreground="#888888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="г. Москва, ул. Тверская, д. 15, оф. 501" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Контакты -->
            <Border Grid.Row="3" Background="#121212" CornerRadius="20" 
                    Padding="24" Margin="0,0,0,24" BorderBrush="#1E1E1E" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📞 Контакты" FontSize="18" FontWeight="SemiBold" 
                               Foreground="White" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Телефон" Foreground="#888888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="+7 (495) 123-45-67" Foreground="White" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Email" Foreground="#888888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="info@ska.ru" Foreground="White" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Сайт" Foreground="#888888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="www.ska.ru" Foreground="#6366F1" VerticalAlignment="Center" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Структура организации (отделы) -->
            <Border Grid.Row="4" Background="#121212" CornerRadius="20" 
                    Padding="24" BorderBrush="#1E1E1E" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🏛️ Структура организации" FontSize="18" FontWeight="SemiBold" 
                               Foreground="White" Margin="0,0,0,20"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="12" Padding="16" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Администрация" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="12 сотрудников" FontSize="12" Foreground="#888888" Margin="0,5,0,0"/>
                                <TextBlock Text="Руководитель: Смирнов А.В." FontSize="11" Foreground="#666666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#1A1A1A" CornerRadius="12" Padding="16" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Отдел аналитики" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="34 сотрудника" FontSize="12" Foreground="#888888" Margin="0,5,0,0"/>
                                <TextBlock Text="Руководитель: Иванов И.И." FontSize="11" Foreground="#666666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#1A1A1A" CornerRadius="12" Padding="16" Margin="5">
                            <StackPanel>
                                <TextBlock Text="IT-департамент" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="28 сотрудников" FontSize="12" Foreground="#888888" Margin="0,5,0,0"/>
                                <TextBlock Text="Руководитель: Петров П.П." FontSize="11" Foreground="#666666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="12" Padding="16" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Отдел контроля" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="19 сотрудников" FontSize="12" Foreground="#888888" Margin="0,5,0,0"/>
                                <TextBlock Text="Руководитель: Сидорова С.А." FontSize="11" Foreground="#666666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#1A1A1A" CornerRadius="12" Padding="16" Margin="5">
                            <StackPanel>
                                <TextBlock Text="HR-отдел" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="8 сотрудников" FontSize="12" Foreground="#888888" Margin="0,5,0,0"/>
                                <TextBlock Text="Руководитель: Козлова М.Д." FontSize="11" Foreground="#666666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#1A1A1A" CornerRadius="12" Padding="16" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Бухгалтерия" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="11 сотрудников" FontSize="12" Foreground="#888888" Margin="0,5,0,0"/>
                                <TextBlock Text="Руководитель: Михайлова Е.А." FontSize="11" Foreground="#666666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
