<Page
    x:Class="SKAProject.Pages.MyOrganizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="1520"
    Height="1080"
    FontFamily="Arian">
    <Grid Margin="0,60,0,0">
        <Border
            Margin="-5,0,-5,15"
            Padding="0"
            Background="#EDF4FF"
            BorderBrush="{DynamicResource BackgroundColor6}"
            BorderThickness="1"
            CornerRadius="30">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="6" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid>
                                        <Border Background="Transparent" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <Grid Margin="40,30,40,50">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Заголовок  -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,32">
                        <TextBlock
                            FontSize="40"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Моя организация" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="30"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Управление информацией о вашей организации" />
                    </StackPanel>

                    <!--  Блок с названием и иконкой  -->
                    <Border
                        Grid.Row="1"
                        Margin="0,0,0,30"
                        Background="{DynamicResource BackgroundColor6}"
                        CornerRadius="30">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="15"
                                Opacity="1"
                                ShadowDepth="0"
                                Color="#010210" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="150"
                                Height="150"
                                Margin="20,30,0,30"
                                Background="{DynamicResource BackgroundColor3}"
                                CornerRadius="20"
                                Opacity="0.4">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="70"
                                    Foreground="{DynamicResource BackgroundColor6}"
                                    Text="🏢" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="TBlockOrgName"
                                    FontFamily="Arian Bold"
                                    FontSize="60"
                                    Foreground="{DynamicResource BackgroundColor3}"
                                    Text="Моя организация" />
                                <TextBlock
                                    x:Name="TBlockOrgOwner"
                                    Margin="0,5,0,0"
                                    FontSize="24"
                                    Foreground="{DynamicResource BackgroundColor3}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Основная информация + Статистика + Сотрудники  -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Основная информация  -->
                        <Border
                            Grid.Column="0"
                            Margin="0,0,20,20"
                            Background="{DynamicResource BackgroundColor3}"
                            CornerRadius="20">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="15"
                                    Opacity="1"
                                    ShadowDepth="0"
                                    Color="#010210" />
                            </Border.Effect>
                            <StackPanel>
                                <Border
                                    Height="50"
                                    Margin="10,10,10,20"
                                    Background="{DynamicResource BackgroundColor6}"
                                    CornerRadius="30">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Arian Bold"
                                        FontSize="30"
                                        Foreground="{DynamicResource BackgroundColor3}"
                                        Text="Основная информация" />
                                </Border>
                                <!--  Адрес  -->
                                <StackPanel Margin="20,0">
                                    <TextBlock
                                        Margin="0,0,0,5"
                                        FontSize="22"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource ForegroundColor1}"
                                        Text="Адрес:" />
                                    <TextBlock
                                        x:Name="TBlockOrgAddress"
                                        FontFamily="Arian Bold"
                                        FontSize="24"
                                        Foreground="{DynamicResource ForegroundColor1}"
                                        Text=""
                                        Visibility="Visible" />
                                    <TextBox
                                        x:Name="TBoxAddress"
                                        Margin="0,0,0,10"
                                        FontFamily="Arian"
                                        FontSize="24"
                                        Style="{DynamicResource TxtBoxStyle}"
                                        Text=""
                                        Visibility="Collapsed" />
                                </StackPanel>
                                <!--  Email  -->
                                <StackPanel Margin="20,15,20,0">
                                    <TextBlock
                                        Margin="0,0,0,5"
                                        FontSize="22"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource ForegroundColor1}"
                                        Text="Email:" />
                                    <TextBlock
                                        x:Name="TBlockOrgEmail"
                                        FontFamily="Arian Bold"
                                        FontSize="24"
                                        Foreground="{DynamicResource ForegroundColor1}"
                                        Text=""
                                        Visibility="Visible" />
                                    <TextBox
                                        x:Name="TBoxEmail"
                                        Margin="0,0,0,10"
                                        FontFamily="Arian"
                                        FontSize="24"
                                        Style="{DynamicResource TxtBoxStyle}"
                                        Text=""
                                        Visibility="Collapsed" />
                                </StackPanel>
                                <!--  Телефон  -->
                                <StackPanel Margin="20,15,20,20">
                                    <TextBlock
                                        Margin="0,0,0,5"
                                        FontSize="22"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource ForegroundColor1}"
                                        Text="Телефон:" />
                                    <TextBlock
                                        x:Name="TBlockOrgPhone"
                                        FontFamily="Arian Bold"
                                        FontSize="24"
                                        Foreground="{DynamicResource ForegroundColor1}"
                                        Text=""
                                        Visibility="Visible" />
                                    <TextBox
                                        x:Name="TBoxPhone"
                                        Margin="0,0,0,10"
                                        FontFamily="Arian"
                                        FontSize="24"
                                        Style="{DynamicResource TxtBoxStyle}"
                                        Text=""
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Правая колонка: статистика и сотрудники  -->
                        <StackPanel Grid.Column="1" Width="300">
                            <!--  Статистика  -->
                            <Border
                                Margin="0,0,0,20"
                                Background="{DynamicResource BackgroundColor3}"
                                CornerRadius="20">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="15"
                                        Opacity="1"
                                        ShadowDepth="0"
                                        Color="#010210" />
                                </Border.Effect>
                                <StackPanel>
                                    <Border
                                        Height="50"
                                        Margin="10,10,10,15"
                                        Background="{DynamicResource BackgroundColor6}"
                                        CornerRadius="30">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Arian Bold"
                                            FontSize="24"
                                            Foreground="{DynamicResource BackgroundColor3}"
                                            Text="Общая статистика" />
                                    </Border>
                                    <StackPanel Margin="15,0,15,15">
                                        <TextBlock
                                            Margin="0,0,0,5"
                                            FontSize="18"
                                            Foreground="{DynamicResource ForegroundColor1}"
                                            Text="👥 Сотрудников:" />
                                        <TextBlock
                                            x:Name="TxtEmployeeCount"
                                            Margin="0,0,0,15"
                                            FontSize="28"
                                            FontWeight="Bold"
                                            Foreground="#6366F1" />
                                        <TextBlock
                                            Margin="0,0,0,5"
                                            FontSize="18"
                                            Foreground="{DynamicResource ForegroundColor1}"
                                            Text="📌 Отделов:" />
                                        <TextBlock
                                            x:Name="TxtDepartmentCount"
                                            Margin="0,0,0,15"
                                            FontSize="28"
                                            FontWeight="Bold"
                                            Foreground="#6366F1" />
                                        <TextBlock
                                            Margin="0,0,0,5"
                                            FontSize="18"
                                            Foreground="{DynamicResource ForegroundColor1}"
                                            Text="💼 Должностей:" />
                                        <TextBlock
                                            x:Name="TxtPositionCount"
                                            FontSize="28"
                                            FontWeight="Bold"
                                            Foreground="#6366F1" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!--  Кнопка Редактировать (в режиме просмотра)  -->
                            <Button
                                x:Name="BtnEdit"
                                Width="180"
                                Height="60"
                                Margin="0,0,0,10"
                                Background="#6366F1"
                                Click="BtnEdit_Click"
                                Cursor="Hand"
                                FontWeight="SemiBold">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontSize="18"
                                        Foreground="White"
                                        Text="✏️" />
                                    <TextBlock
                                        FontSize="18"
                                        Foreground="White"
                                        Text="Редактировать" />
                                </StackPanel>
                            </Button>

                            <!--  Кнопки Сохранить и Отмена (скрыты)  -->
                            <StackPanel
                                x:Name="PanelSaveCancel"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                                <Button
                                    x:Name="BtnSave"
                                    Width="120"
                                    Height="60"
                                    Margin="0,0,10,0"
                                    Background="#10B981"
                                    Click="BtnSave_Click"
                                    Cursor="Hand"
                                    FontWeight="SemiBold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,8,0"
                                            FontSize="18"
                                            Foreground="White"
                                            Text="💾" />
                                        <TextBlock
                                            FontSize="18"
                                            Foreground="White"
                                            Text="Сохранить" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="BtnCancel"
                                    Width="120"
                                    Height="60"
                                    Background="#6B7280"
                                    Click="BtnCancel_Click"
                                    Cursor="Hand"
                                    FontWeight="SemiBold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,8,0"
                                            FontSize="18"
                                            Foreground="White"
                                            Text="↩" />
                                        <TextBlock
                                            FontSize="18"
                                            Foreground="White"
                                            Text="Отмена" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!--  Отделы и должности  -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Отделы  -->
                        <Border
                            Grid.Column="0"
                            Margin="0,0,0,20"
                            Background="{DynamicResource BackgroundColor3}"
                            CornerRadius="20">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="15"
                                    Opacity="1"
                                    ShadowDepth="0"
                                    Color="#010210" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border
                                    Height="50"
                                    Margin="10,10,10,15"
                                    Background="{DynamicResource BackgroundColor6}"
                                    CornerRadius="20">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Arian Bold"
                                        FontSize="28"
                                        Foreground="{DynamicResource BackgroundColor3}"
                                        Text="Отделы" />
                                </Border>
                                <Button
                                    Grid.Row="1"
                                    Height="40"
                                    Margin="20,0,20,10"
                                    Background="{DynamicResource BackgroundColor6}"
                                    Click="BtnAddDepartment"
                                    Content="+ Добавить отдел"
                                    Cursor="Hand"
                                    FontSize="16"
                                    Foreground="White"
                                    Style="{DynamicResource LogBtnStyle}" />
                                <Border
                                    Grid.Row="2"
                                    Height="1"
                                    Margin="20,0"
                                    Background="#E2E8F0" />
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="DepartmentsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="15,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="40" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="18"
                                                        Foreground="{DynamicResource ForegroundColor1}"
                                                        Text="{Binding DepName}" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="DeleteDepartment_Click"
                                                        CommandParameter="{Binding DepID}"
                                                        Cursor="Hand">
                                                        <TextBlock FontSize="16" Text="🗑️" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!--  Должности  -->
                        <Border
                            Grid.Column="2"
                            Margin="0,0,0,20"
                            Background="{DynamicResource BackgroundColor3}"
                            CornerRadius="20">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="15"
                                    Opacity="1"
                                    ShadowDepth="0"
                                    Color="#010210" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border
                                    Height="50"
                                    Margin="10,10,10,15"
                                    Background="{DynamicResource BackgroundColor6}"
                                    CornerRadius="20">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Arian Bold"
                                        FontSize="28"
                                        Foreground="{DynamicResource BackgroundColor3}"
                                        Text="Должности" />
                                </Border>
                                <Button
                                    Grid.Row="1"
                                    Height="40"
                                    Margin="20,0,20,10"
                                    Background="{DynamicResource BackgroundColor6}"
                                    Click="BtnAddPost"
                                    Content="+ Добавить должность"
                                    Cursor="Hand"
                                    FontSize="16"
                                    Foreground="White"
                                    Style="{DynamicResource LogBtnStyle}" />
                                <Border
                                    Grid.Row="2"
                                    Height="1"
                                    Margin="20,0"
                                    Background="#E2E8F0" />
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="PositionsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="15,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="40" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="18"
                                                        Foreground="{DynamicResource ForegroundColor1}"
                                                        Text="{Binding PosName}" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="DeletePosition_Click"
                                                        CommandParameter="{Binding PosID}"
                                                        Cursor="Hand">
                                                        <TextBlock FontSize="16" Text="🗑️" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!--  Резервное место для будущих виджетов (можно убрать)  -->
                    <Grid Grid.Row="4" Height="200">
                        <Border Background="{DynamicResource BackgroundColor3}" CornerRadius="20">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="15"
                                    Opacity="1"
                                    ShadowDepth="0"
                                    Color="#010210" />
                            </Border.Effect>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="40"
                                Foreground="{DynamicResource ForegroundColor1}"
                                Opacity="0.3"
                                Text="Здесь что-то будет" />
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>