<Page
    x:Class="SKAProject.Pages.MyOrganizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Моя организация"
    Background="{DynamicResource ContentBackgroundBrush}"
    FontFamily="Arian">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Заголовок  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock
                FontSize="36"
                FontWeight="SemiBold"
                Foreground="{DynamicResource ForegroundColor1}"
                Text="Моя организация" />
            <TextBlock
                Margin="0,8,0,0"
                FontSize="22"
                Foreground="{DynamicResource ForegroundColor1}"
                Text="Управление информацией о вашей организации" />
        </StackPanel>

        <!--  Основная информация + статистика  -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="0,0,20,0"
                Background="{DynamicResource BackgroundColor3}"
                CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="15"
                        Opacity="1"
                        ShadowDepth="0"
                        Color="#010210" />
                </Border.Effect>
                <StackPanel>
                    <Border
                        Height="50"
                        Margin="10,10,10,15"
                        Background="{DynamicResource BackgroundColor6}"
                        CornerRadius="20">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Arian Bold"
                            FontSize="24"
                            Foreground="{DynamicResource BackgroundColor3}"
                            Text="Основная информация" />
                    </Border>
                    <StackPanel Margin="20,0">
                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Адрес:" />
                        <TextBlock
                            x:Name="TBlockOrgAddress"
                            FontSize="22"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Visibility="Visible" />
                        <TextBox
                            x:Name="TBoxAddress"
                            Margin="0,0,0,10"
                            FontSize="22"
                            Style="{DynamicResource TxtBoxStyle}"
                            Visibility="Collapsed" />

                        <TextBlock
                            Margin="0,10,0,5"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Email:" />
                        <TextBlock
                            x:Name="TBlockOrgEmail"
                            FontSize="22"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Visibility="Visible" />
                        <TextBox
                            x:Name="TBoxEmail"
                            Margin="0,0,0,10"
                            FontSize="22"
                            Style="{DynamicResource TxtBoxStyle}"
                            Visibility="Collapsed" />

                        <TextBlock
                            Margin="0,10,0,5"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Text="Телефон:" />
                        <TextBlock
                            x:Name="TBlockOrgPhone"
                            FontSize="22"
                            Foreground="{DynamicResource ForegroundColor1}"
                            Visibility="Visible" />
                        <TextBox
                            x:Name="TBoxPhone"
                            Margin="0,0,0,10"
                            FontSize="22"
                            Style="{DynamicResource TxtBoxStyle}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Width="300">
                <Border
                    Margin="0,0,0,15"
                    Background="{DynamicResource BackgroundColor3}"
                    CornerRadius="20">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="15"
                            Opacity="1"
                            ShadowDepth="0"
                            Color="#010210" />
                    </Border.Effect>
                    <StackPanel>
                        <Border
                            Height="50"
                            Margin="10,10,10,15"
                            Background="{DynamicResource BackgroundColor6}"
                            CornerRadius="20">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Arian Bold"
                                FontSize="24"
                                Foreground="{DynamicResource BackgroundColor3}"
                                Text="Статистика" />
                        </Border>
                        <StackPanel Margin="15,0,15,15">
                            <TextBlock
                                Margin="0,0,0,5"
                                FontSize="18"
                                Foreground="{DynamicResource ForegroundColor1}"
                                Text="👥 Сотрудников:" />
                            <TextBlock
                                x:Name="TxtEmployeeCount"
                                Margin="0,0,0,15"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="#6366F1" />
                            <TextBlock
                                Margin="0,0,0,5"
                                FontSize="18"
                                Foreground="{DynamicResource ForegroundColor1}"
                                Text="📌 Отделов:" />
                            <TextBlock
                                x:Name="TxtDepartmentCount"
                                Margin="0,0,0,15"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="#6366F1" />
                            <TextBlock
                                Margin="0,0,0,5"
                                FontSize="18"
                                Foreground="{DynamicResource ForegroundColor1}"
                                Text="💼 Должностей:" />
                            <TextBlock
                                x:Name="TxtPositionCount"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="#6366F1" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button
                    x:Name="BtnEdit"
                    Width="180"
                    Height="45"
                    Margin="0,0,0,10"
                    Background="{DynamicResource BackgroundColor6}"
                    BorderThickness="0"
                    Click="BtnEdit_Click"
                    Cursor="Hand"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            FontSize="18"
                            Text="✏️" />
                        <TextBlock Text="Редактировать" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--  Отделы и должности  -->
        <Grid Grid.Row="2" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{DynamicResource BackgroundColor3}"
                CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="15"
                        Opacity="1"
                        ShadowDepth="0"
                        Color="#010210" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Height="50"
                        Margin="10,10,10,15"
                        Background="{DynamicResource BackgroundColor6}"
                        CornerRadius="20">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Arian Bold"
                            FontSize="24"
                            Foreground="{DynamicResource BackgroundColor3}"
                            Text="Отделы" />
                    </Border>
                    <Button
                        Grid.Row="1"
                        Height="40"
                        Margin="20,0,20,10"
                        Background="{DynamicResource BackgroundColor6}"
                        BorderThickness="0"
                        Click="BtnAddDepartment"
                        Content="+ Добавить отдел"
                        Cursor="Hand"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DepartmentsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="15,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            Foreground="{DynamicResource ForegroundColor1}"
                                            Text="{Binding DepName}" />
                                        <Button
                                            Grid.Column="1"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="DeleteDepartment_Click"
                                            CommandParameter="{Binding DepID}"
                                            Content="🗑️"
                                            Cursor="Hand" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Background="{DynamicResource BackgroundColor3}"
                CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="15"
                        Opacity="1"
                        ShadowDepth="0"
                        Color="#010210" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Height="50"
                        Margin="10,10,10,15"
                        Background="{DynamicResource BackgroundColor6}"
                        CornerRadius="20">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Arian Bold"
                            FontSize="24"
                            Foreground="{DynamicResource BackgroundColor3}"
                            Text="Должности" />
                    </Border>
                    <Button
                        Grid.Row="1"
                        Height="40"
                        Margin="20,0,20,10"
                        Background="{DynamicResource BackgroundColor6}"
                        BorderThickness="0"
                        Click="BtnAddPost"
                        Content="+ Добавить должность"
                        Cursor="Hand"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PositionsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="15,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            Foreground="{DynamicResource ForegroundColor1}"
                                            Text="{Binding PosName}" />
                                        <Button
                                            Grid.Column="1"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="DeletePosition_Click"
                                            CommandParameter="{Binding PosID}"
                                            Content="🗑️"
                                            Cursor="Hand" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>