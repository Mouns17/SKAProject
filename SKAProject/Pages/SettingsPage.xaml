<Page x:Class="SKAProject.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SettingsPage"
      Background="#0A0A0A" FontFamily="Arian">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,30,40,50">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="0,0,0,32">
                <TextBlock Text="Настройки" FontSize="34" FontWeight="SemiBold" 
                           Foreground="#FFFFFF"/>
                <TextBlock Text="Управление параметрами системы и личными настройками" 
                           FontSize="14" Foreground="#888888" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Общие настройки -->
            <Border Grid.Row="1" Background="#121212" CornerRadius="20" 
                    Padding="24" Margin="0,0,0,24" BorderBrush="#1E1E1E" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="⚙️ Общие настройки" FontSize="18" FontWeight="SemiBold" 
                               Foreground="White" Margin="0,0,0,20"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Тема оформления" Foreground="#888888" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Width="200" Height="38" VerticalAlignment="Center">
                            <ComboBoxItem Content="Тёмная" IsSelected="True"/>
                            <ComboBoxItem Content="Светлая"/>
                            <ComboBoxItem Content="Системная"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Язык интерфейса" Foreground="#888888" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Width="200" Height="38" VerticalAlignment="Center">
                            <ComboBoxItem Content="Русский" IsSelected="True"/>
                            <ComboBoxItem Content="English"/>
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Формат даты" Foreground="#888888" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Width="200" Height="38" VerticalAlignment="Center">
                            <ComboBoxItem Content="ДД.ММ.ГГГГ" IsSelected="True"/>
                            <ComboBoxItem Content="ММ/ДД/ГГГГ"/>
                            <ComboBoxItem Content="ГГГГ-ММ-ДД"/>
                        </ComboBox>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Часовой пояс" Foreground="#888888" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" Width="200" Height="38" VerticalAlignment="Center">
                            <ComboBoxItem Content="Москва (UTC+3)" IsSelected="True"/>
                            <ComboBoxItem Content="Екатеринбург (UTC+5)"/>
                            <ComboBoxItem Content="Владивосток (UTC+10)"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Уведомления -->
            <Border Grid.Row="2" Background="#121212" CornerRadius="20" 
                    Padding="24" Margin="0,0,0,24" BorderBrush="#1E1E1E" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🔔 Уведомления" FontSize="18" FontWeight="SemiBold" 
                               Foreground="White" Margin="0,0,0,20"/>

                    <CheckBox x:Name="EmailNotifications" Margin="0,10" Foreground="White">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="#1A1A1A" 
                                            BorderBrush="#2A2A2A" BorderThickness="1">
                                        <TextBlock x:Name="CheckMark" Text="✓" Foreground="#6366F1" 
                                                   FontSize="14" HorizontalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>
                                    <ContentPresenter Margin="10,0,0,0"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                        Уведомления на email
                    </CheckBox>

                    <CheckBox x:Name="TelegramNotifications" Margin="0,10" Foreground="White">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="#1A1A1A" 
                                            BorderBrush="#2A2A2A" BorderThickness="1">
                                        <TextBlock x:Name="CheckMark" Text="✓" Foreground="#6366F1" 
                                                   FontSize="14" HorizontalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>
                                    <ContentPresenter Margin="10,0,0,0"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                        Уведомления в Telegram
                    </CheckBox>

                    <CheckBox x:Name="PushNotifications" Margin="0,10" Foreground="White" IsChecked="True">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="#1A1A1A" 
                                            BorderBrush="#2A2A2A" BorderThickness="1">
                                        <TextBlock x:Name="CheckMark" Text="✓" Foreground="#6366F1" 
                                                   FontSize="14" HorizontalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>
                                    <ContentPresenter Margin="10,0,0,0"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                        Push-уведомления
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Безопасность -->
            <Border Grid.Row="3" Background="#121212" CornerRadius="20" 
                    Padding="24" Margin="0,0,0,24" BorderBrush="#1E1E1E" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🔒 Безопасность" FontSize="18" FontWeight="SemiBold" 
                               Foreground="White" Margin="0,0,0,20"/>

                    <Button Height="44" Background="#1A1A1A" Foreground="White" 
                            HorizontalAlignment="Left" Width="200" Margin="0,5"
                            BorderBrush="#2A2A2A" BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        Сменить пароль
                    </Button>

                    <Button Height="44" Background="#1A1A1A" Foreground="White" 
                            HorizontalAlignment="Left" Width="200" Margin="0,5"
                            BorderBrush="#2A2A2A" BorderThickness="1">
                        Включить двухфакторную аутентификацию
                    </Button>
                </StackPanel>
            </Border>

            <!-- Кнопка сохранения -->
            <Button Grid.Row="4" Height="50" Background="#6366F1" Foreground="White" 
                    FontSize="14" Cursor="Hand" Width="200" HorizontalAlignment="Left">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                Сохранить настройки
            </Button>
        </Grid>
    </ScrollViewer>
</Page>