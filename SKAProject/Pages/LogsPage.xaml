<Page
    x:Class="SKAProject.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WorkersPage"
    Width="1520"
    Height="1080"
    FontFamily="Arian">
    <Grid Margin="0,60,0,0">
        <Border
            Margin="-5,0,-5,15"
            Padding="0"
            Background="#EDF4FF"
            BorderBrush="{StaticResource BackgroundColor6}"
            BorderThickness="1"
            CornerRadius="30">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="6" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid>
                                        <Border Background="Transparent" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <Grid Margin="40,30,40,50">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Заголовок и панель управления  -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,32">
                        <TextBlock
                            FontSize="40"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ForegroundColor1}"
                            Text="Логи системы" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="30"
                            Foreground="{StaticResource ForegroundColor1}"
                            Text="Журнал событий и действий пользователей" />
                    </StackPanel>

                    <!--  Панель инструментов (поиск, фильтр, кнопки)  -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <!--  Верхняя строка: Поиск и кнопки  -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="330" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>

                            <!--  Поисковая строка  -->
                            <Border
                                Grid.Column="0"
                                Height="55"
                                Margin="0,0,20,0"
                                Background="{StaticResource BackgroundColor3}"
                                BorderBrush="{StaticResource BackgroundColor6}"
                                BorderThickness="1"
                                CornerRadius="15">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="15"
                                        Opacity="0.8"
                                        ShadowDepth="0"
                                        Color="#010210" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="20,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Foreground="{StaticResource ForegroundColor1}"
                                        Text="🔍" />
                                    <TextBox
                                        x:Name="SearchTextBox"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontFamily="Arian"
                                        FontSize="18"
                                        Foreground="{StaticResource ForegroundColor1}" />
                                    <TextBlock
                                        x:Name="SearchPlaceholder"
                                        Grid.Column="1"
                                        Margin="2,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Arian"
                                        FontSize="18"
                                        Foreground="#8899AA"
                                        IsHitTestVisible="False"
                                        Text="Поиск по пользователю, дате, типу..." />
                                </Grid>
                            </Border>

                            <!--  Фильтр по отделу  -->
                            <TextBlock
                                Grid.Column="1"
                                Margin="0,0,15,0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{StaticResource ForegroundColor1}"
                                Text="По типу:" />
                            <ComboBox
                                x:Name="DepartmentFilterComboBox"
                                Grid.Column="1"
                                Width="200"
                                Height="45"
                                Margin="80,0,25,0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="{StaticResource BackgroundColor3}"
                                BorderThickness="0"
                                FontSize="18"
                                Foreground="{StaticResource ForegroundColor1}">
                                <ComboBox.Effect>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        Opacity="0.5"
                                        ShadowDepth="0"
                                        Color="#010210" />
                                </ComboBox.Effect>
                            </ComboBox>

                            <!--  Фильтр по должности  -->
                            <TextBlock
                                Grid.Column="2"
                                Margin="0,0,15,0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{StaticResource ForegroundColor1}"
                                Text="По дате:" />
                            <ComboBox
                                x:Name="PositionFilterComboBox"
                                Grid.Column="3"
                                Width="160"
                                Height="45"
                                Margin="80,0,25,0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="{StaticResource BackgroundColor3}"
                                BorderThickness="0"
                                FontSize="18"
                                Foreground="{StaticResource ForegroundColor1}">
                                <ComboBox.Effect>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        Opacity="0.5"
                                        ShadowDepth="0"
                                        Color="#010210" />
                                </ComboBox.Effect>
                                <ComboBoxItem
                                    Content="За всё время"
                                    IsSelected="True"
                                    Tag="all" />
                                <ComboBoxItem Content="Сегодня" Tag="today" />
                                <ComboBoxItem Content="Вчера" Tag="yesterday" />
                                <ComboBoxItem Content="Последние 7 дней" Tag="7days" />
                                <ComboBoxItem Content="Последние 30 дней" Tag="30days" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <!--  Таблица сотрудников в стиле логов  -->
                    <Border
                        Grid.Row="2"
                        Background="{StaticResource BackgroundColor3}"
                        CornerRadius="20">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="15"
                                Opacity="1"
                                ShadowDepth="0"
                                Color="#010210" />
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Заголовок таблицы  -->
                            <Border
                                Grid.Row="0"
                                Background="#F0F5FF"
                                BorderBrush="#D0D9E8"
                                BorderThickness="0,0,0,2"
                                CornerRadius="20 20 0 0">
                                <Grid Height="60">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="340" />
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="320" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="30,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#4A5568"
                                        Text="Дата и время" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#4A5568"
                                        Text="Пользователь" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Margin="50,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#4A5568"
                                        Text="Событие" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Margin="80,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#4A5568"
                                        Text="Тип" />
                                    <TextBlock
                                        Grid.Column="5"
                                        Margin="90,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#4A5568"
                                        Text="Описание" />
                                </Grid>
                            </Border>

                            <!--  Логи  -->
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Hidden">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Width" Value="6" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </ScrollViewer.Resources>

                                <ItemsControl x:Name="LogsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Background="Transparent"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="0,0,0,1">
                                                <Grid Height="65">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="260" />
                                                        <ColumnDefinition Width="260" />
                                                        <ColumnDefinition Width="260" />
                                                        <ColumnDefinition Width="260" />
                                                        <ColumnDefinition Width="280" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Margin="30,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="#4A5568"
                                                        Text="{Binding CreatedAtStr}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        FontWeight="SemiBold"
                                                        Foreground="#2D3748"
                                                        Text="{Binding UserName}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Margin="50,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="#4A5568"
                                                        Text="{Binding Action}" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        Margin="50,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="#4A5568"
                                                        Text="{Binding EventType}" />
                                                    <TextBlock
                                                        Grid.Column="4"
                                                        Margin="70,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="#4A5568"
                                                        Text="{Binding Description}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
