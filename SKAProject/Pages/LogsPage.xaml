<Page x:Class="SKAProject.Pages.LogsPage"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="LogsPage"
      Background="#0A0A0A" FontFamily="Arian">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,30,40,50">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="0,0,0,32">
                <TextBlock Text="Логи системы" FontSize="34" FontWeight="SemiBold" 
                           Foreground="#FFFFFF"/>
                <TextBlock Text="Журнал событий и действий пользователей" 
                           FontSize="14" Foreground="#888888" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Фильтры -->
            <Border Grid.Row="1" Background="#121212" CornerRadius="20" 
                    Padding="20" Margin="0,0,0,24" BorderBrush="#1E1E1E" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#1A1A1A" CornerRadius="10" Height="40" Width="180" Margin="0,0,10,0">
                        <ComboBox Background="Transparent" BorderThickness="0" Foreground="White" 
                                  VerticalContentAlignment="Center" Height="40">
                            <ComboBoxItem Content="Все события" IsSelected="True"/>
                            <ComboBoxItem Content="Вход в систему"/>
                            <ComboBoxItem Content="Создание"/>
                            <ComboBoxItem Content="Изменение"/>
                            <ComboBoxItem Content="Удаление"/>
                        </ComboBox>
                    </Border>

                    <Border Background="#1A1A1A" CornerRadius="10" Height="40" Width="180" Margin="0,0,10,0">
                        <ComboBox Background="Transparent" BorderThickness="0" Foreground="White" 
                                  VerticalContentAlignment="Center" Height="40">
                            <ComboBoxItem Content="Все пользователи" IsSelected="True"/>
                            <ComboBoxItem Content="Иванов И.И."/>
                            <ComboBoxItem Content="Петров П.П."/>
                            <ComboBoxItem Content="Сидорова С.А."/>
                        </ComboBox>
                    </Border>

                    <Border Background="#1A1A1A" CornerRadius="10" Height="40" Width="150">
                        <ComboBox Background="Transparent" BorderThickness="0" Foreground="White" 
                                  VerticalContentAlignment="Center" Height="40">
                            <ComboBoxItem Content="За неделю" IsSelected="True"/>
                            <ComboBoxItem Content="За месяц"/>
                            <ComboBoxItem Content="За год"/>
                        </ComboBox>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Таблица логов -->
            <Border Grid.Row="2" Background="#121212" CornerRadius="20" 
                    Padding="0" BorderBrush="#1E1E1E" BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовки -->
                        <Border Grid.Row="0" Background="#1A1A1A" Padding="15,12" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Дата и время" FontWeight="SemiBold" Foreground="#888888"/>
                                <TextBlock Grid.Column="1" Text="Пользователь" FontWeight="SemiBold" Foreground="#888888"/>
                                <TextBlock Grid.Column="2" Text="Событие" FontWeight="SemiBold" Foreground="#888888"/>
                                <TextBlock Grid.Column="3" Text="Тип" FontWeight="SemiBold" Foreground="#888888"/>
                                <TextBlock Grid.Column="4" Text="Описание" FontWeight="SemiBold" Foreground="#888888"/>
                                <TextBlock Grid.Column="5" Text="IP-адрес" FontWeight="SemiBold" Foreground="#888888"/>
                            </Grid>
                        </Border>

                        <!-- Лог 1 -->
                        <Border Grid.Row="1" Padding="15,12" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="24.03.2025 09:15:23" Foreground="White" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="Иванов И.И." Foreground="White" FontSize="13"/>
                                <TextBlock Grid.Column="2" Text="Вход в систему" Foreground="White" FontSize="13"/>
                                <Border Grid.Column="3" Background="#10B981" CornerRadius="10" Padding="8,2" Width="80" HorizontalAlignment="Left">
                                    <TextBlock Text="INFO" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="4" Text="Успешная авторизация пользователя" Foreground="#888888" FontSize="13"/>
                                <TextBlock Grid.Column="5" Text="192.168.1.1" Foreground="#888888" FontSize="13"/>
                            </Grid>
                        </Border>

                        <!-- Лог 2 -->
                        <Border Grid.Row="2" Padding="15,12" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="24.03.2025 10:32:47" Foreground="White" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="Петров П.П." Foreground="White" FontSize="13"/>
                                <TextBlock Grid.Column="2" Text="Создание задачи" Foreground="White" FontSize="13"/>
                                <Border Grid.Column="3" Background="#6366F1" CornerRadius="10" Padding="8,2" Width="80" HorizontalAlignment="Left">
                                    <TextBlock Text="CREATE" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="4" Text="Создана новая задача организации: &quot;Аудит безопасности&quot;" Foreground="#888888" FontSize="13"/>
                                <TextBlock Grid.Column="5" Text="192.168.1.2" Foreground="#888888" FontSize="13"/>
                            </Grid>
                        </Border>

                        <!-- Лог 3 -->
                        <Border Grid.Row="3" Padding="15,12" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="23.03.2025 14:20:11" Foreground="White" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="Сидорова С.А." Foreground="White" FontSize="13"/>
                                <TextBlock Grid.Column="2" Text="Изменение отчета" Foreground="White" FontSize="13"/>
                                <Border Grid.Column="3" Background="#F59E0B" CornerRadius="10" Padding="8,2" Width="80" HorizontalAlignment="Left">
                                    <TextBlock Text="UPDATE" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="4" Text="Обновлен недельный отчет, добавлены новые данные" Foreground="#888888" FontSize="13"/>
                                <TextBlock Grid.Column="5" Text="192.168.1.3" Foreground="#888888" FontSize="13"/>
                            </Grid>
                        </Border>

                        <!-- Лог 4 -->
                        <Border Grid.Row="4" Padding="15,12" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="23.03.2025 16:45:33" Foreground="White" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="Козлова М.Д." Foreground="White" FontSize="13"/>
                                <TextBlock Grid.Column="2" Text="Просмотр профиля" Foreground="White" FontSize="13"/>
                                <Border Grid.Column="3" Background="#6366F1" CornerRadius="10" Padding="8,2" Width="80" HorizontalAlignment="Left">
                                    <TextBlock Text="VIEW" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="4" Text="Просмотр карточки сотрудника Иванов И.И." Foreground="#888888" FontSize="13"/>
                                <TextBlock Grid.Column="5" Text="192.168.1.4" Foreground="#888888" FontSize="13"/>
                            </Grid>
                        </Border>

                        <!-- Лог 5 - ошибка -->
                        <Border Grid.Row="5" Padding="15,12" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="22.03.2025 11:08:52" Foreground="White" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="Система" Foreground="White" FontSize="13"/>
                                <TextBlock Grid.Column="2" Text="Ошибка БД" Foreground="White" FontSize="13"/>
                                <Border Grid.Column="3" Background="#EC4899" CornerRadius="10" Padding="8,2" Width="80" HorizontalAlignment="Left">
                                    <TextBlock Text="ERROR" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="4" Text="Ошибка подключения к базе данных, выполнено переподключение" Foreground="#888888" FontSize="13"/>
                                <TextBlock Grid.Column="5" Text="localhost" Foreground="#888888" FontSize="13"/>
                            </Grid>
                        </Border>

                        <!-- Лог 6 -->
                        <Border Grid.Row="6" Padding="15,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="22.03.2025 09:00:15" Foreground="White" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="Админ" Foreground="White" FontSize="13"/>
                                <TextBlock Grid.Column="2" Text="Выход из системы" Foreground="White" FontSize="13"/>
                                <Border Grid.Column="3" Background="#10B981" CornerRadius="10" Padding="8,2" Width="80" HorizontalAlignment="Left">
                                    <TextBlock Text="INFO" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="4" Text="Пользователь завершил сеанс работы" Foreground="#888888" FontSize="13"/>
                                <TextBlock Grid.Column="5" Text="192.168.1.1" Foreground="#888888" FontSize="13"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
