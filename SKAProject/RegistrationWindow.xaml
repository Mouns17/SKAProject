<Window x:Class="SKAProject.RegistrationWindow"
        WindowStyle="None"
        WindowState="Normal"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        Height="480"
        Width="720"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">

        <!-- Используем те же стили -->
        <Grid.Resources>

            <!-- Разделительная линия -->
            <LinearGradientBrush x:Key="DividerBrush"
                                 StartPoint="0,0"
                                 EndPoint="1,0">

                <GradientStop Color="#00250044" Offset="0"/>
                <GradientStop Color="#FF250044" Offset="0.5"/>
                <GradientStop Color="#FF2e0055" Offset="0.7"/>
                <GradientStop Color="#002e0055" Offset="1"/>

            </LinearGradientBrush>

        </Grid.Resources>

        <!-- Главная карточка -->
        <Border Width="720"
                Height="480"
                CornerRadius="20"
                Background="#bdbdbd"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая панель -->
                <Border Grid.Column="0"
                        CornerRadius="20,120,120,20"
                        Background="#250044">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Width="270">

                        <TextBlock Text="Регистрация"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Заполните данные для создания аккаунта"
                                   FontSize="14"
                                   Foreground="#D0D0D0"
                                   TextAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <!-- Кнопка Назад -->
                        <Button Content="Назад"
                                Style="{StaticResource RegBtnStyle}"
                                Click="BackToLogin"/>

                    </StackPanel>

                </Border>

                <!-- Правая часть -->
                <Grid Grid.Column="1"
                      Margin="35">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Создание аккаунта"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="Введите личные данные"
                                   FontSize="12"
                                   Foreground="#250044"
                                   TextAlignment="Center"/>

                        <!-- Линия -->
                        <Border Height="1"
                                Margin="0,10"
                                Background="{StaticResource DividerBrush}"/>

                        <!-- Имя -->
                        <TextBox Style="{StaticResource TxtBoxStyle}"
                                 Tag="Введите имя"
                                 Height="35"
                                 Width="300"
                                 Margin="0 6"
                                 HorizontalAlignment="Center"/>

                        <!-- Фамилия -->
                        <TextBox Style="{StaticResource TxtBoxStyle}"
                                 Tag="Введите фамилию"
                                 Height="35"
                                 Width="300"
                                 Margin="0 6"
                                 HorizontalAlignment="Center"/>

                        <!-- Отчество -->
                        <TextBox Style="{StaticResource TxtBoxStyle}"
                                 Tag="Введите отчество"
                                 Height="35"
                                 Width="300"
                                 Margin="0 6"
                                 HorizontalAlignment="Center"/>

                        <!-- Телефон -->
                        <TextBox Style="{StaticResource TxtBoxStyle}"
                                 Tag="Введите номер телефона"
                                 Height="35"
                                 Width="300"
                                 Margin="0 6"
                                 HorizontalAlignment="Center"/>

                        <!-- Линия -->
                        <Border Height="1"
                                Margin="0,10"
                                Background="{StaticResource DividerBrush}"/>

                        <!-- Кнопка регистрации -->
                        <Button Content="Зарегистрироваться"
                                Style="{StaticResource LogBtnStyle}"
                                Margin="20 10 20 0"
                                Click="RegisterUser"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>