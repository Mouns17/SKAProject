<Window
    x:Class="SKAProject.RegistrationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SKAProject"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="720"
    Height="480"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Arian"
    ResizeMode="NoResize"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
        <Border
            Width="720"
            Height="480"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource BackgroundColor2}"
            CornerRadius="20">
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Левая панель  -->
                <Border
                    Grid.Column="0"
                    Background="{DynamicResource BackgroundColor6}"
                    CornerRadius="20,120,120,20">

                    <StackPanel
                        Width="270"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="{DynamicResource BackgroundColor3}"
                            Text="Регистрация"
                            TextAlignment="Center" />

                        <TextBlock
                            Margin="0,0,0,20"
                            FontSize="14"
                            Foreground="{DynamicResource BackgroundColor3}"
                            Text="Заполните данные для создания аккаунта"
                            TextAlignment="Center" />

                        <Button
                            Click="BtnBack"
                            Content="Назад"
                            Style="{DynamicResource RegBtnStyle}" />

                    </StackPanel>
                </Border>

                <!--  Правая часть  -->
                <Grid Grid.Column="1">
                    <StackPanel>

                        <Button
                            Margin="292,10,0,0"
                            Click="BtnRollup"
                            Content="➖"
                            Style="{DynamicResource ControlBtnStyle}" />

                        <Button
                            Margin="345,-25,0,70"
                            Click="BtnClose"
                            Content="✖︎"
                            Style="{DynamicResource ControlBtnStyle}" />

                        <TextBlock
                            Margin="0,0,0,5"
                            HorizontalAlignment="Center"
                            FontSize="28"
                            FontWeight="Bold"
                            Text="Создание аккаунта" />

                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource BackgroundColor6}"
                            Text="Введите личные данные"
                            TextAlignment="Center" />

                        <Border
                            Height="1"
                            Margin="0,10"
                            Background="{DynamicResource DividerBrush}" />

                        <TextBox
                            x:Name="TBoxLogin"
                            Width="300"
                            Height="35"
                            Margin="0,6"
                            HorizontalAlignment="Center"
                            Style="{DynamicResource TxtBoxStyle}"
                            Tag="Введите логин"
                            Visibility="Visible" />

                        <TextBox
                            x:Name="TBoxPassword"
                            Width="300"
                            Height="35"
                            Margin="0,6"
                            HorizontalAlignment="Center"
                            Style="{DynamicResource TxtBoxStyle}"
                            Tag="Введите пароль"
                            Visibility="Visible" />

                        <TextBox
                            x:Name="TBoxRePassword"
                            Width="300"
                            Height="35"
                            Margin="0,6"
                            HorizontalAlignment="Center"
                            Style="{DynamicResource TxtBoxStyle}"
                            Tag="Повторите пароль"
                            Visibility="Visible" />

                        <TextBox
                            x:Name="TBoxFirstName"
                            Width="300"
                            Height="35"
                            Margin="0,6"
                            HorizontalAlignment="Center"
                            Style="{DynamicResource TxtBoxStyle}"
                            Tag="Введите имя"
                            Visibility="Collapsed" />

                        <TextBox
                            x:Name="TBoxLastName"
                            Width="300"
                            Height="35"
                            Margin="0,6"
                            HorizontalAlignment="Center"
                            Style="{DynamicResource TxtBoxStyle}"
                            Tag="Введите фамилию"
                            Visibility="Collapsed" />

                        <TextBox
                            x:Name="TBoxMiddleName"
                            Width="300"
                            Height="35"
                            Margin="0,6"
                            HorizontalAlignment="Center"
                            Style="{DynamicResource TxtBoxStyle}"
                            Tag="Введите отчество"
                            Visibility="Collapsed" />

                        <Border
                            Height="1"
                            Margin="0,10"
                            Background="{DynamicResource DividerBrush}" />

                        <Button
                            x:Name="BtnNextRegVis"
                            Margin="50,10,50,0"
                            Click="BtnNextReg"
                            Content="Продолжить &gt; &gt; &gt;"
                            Style="{DynamicResource LogBtnStyle}"
                            Visibility="Visible" />

                        <Button
                            x:Name="BtnRegisterVis"
                            Margin="50,10,50,0"
                            Click="BtnRegister"
                            Content="Зарегистрироваться"
                            Style="{DynamicResource LogBtnStyle}"
                            Visibility="Collapsed" />

                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>