<Window x:Class="SKAProject.LoginWindow" WindowStyle="None" WindowState="Normal" Topmost="True" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" AllowsTransparency="True" Background="Transparent"  
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SKAProject"
        mc:Ignorable="d"
        Height="480" Width="720">
    <Grid MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
        <Grid.Resources>
            <!-- Стиль для TextBox в виде плашки с изменением обводки при фокусе типа -->
            <Style x:Key="TxtBoxStyle" TargetType="TextBox">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#250044"/>
                <Setter Property="BorderThickness" Value="1.4"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <Border x:Name="Border" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="10 0"/>
                                <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="DimGray" Margin="22 0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#513965"/>
                                </Trigger>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- Стиль для кнопки перехода далее -->
            <Style x:Key="LogBtnStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="#250044"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#FFFFFF"/>
                                </Trigger>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#370066"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Стиль для кнопки перехода в окно регистрации -->
            <Style x:Key="RegBtnStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="White"/>
                <Setter Property="BorderThickness" Value="1.4"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Width" Value="140"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="DimGray"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="WhiteSmoke"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Foreground" Value="Black"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        
        <Border Width="720" Height="480" CornerRadius="20" Background="#bdbdbd" HorizontalAlignment="Center" VerticalAlignment="Center">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="20,120,120,20" Background="#250044">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="270">
                        <TextBlock Text="Добро пожаловать!" FontSize="26" FontWeight="Bold" Foreground="White" TextAlignment="Center" Margin="0,0,0,10"/>

                        <TextBlock Text="Ещё нет аккаунта?" FontSize="14" Foreground="#D0D0D0" TextAlignment="Center" Margin="0,0,0,20"/>

                        <Button Content="Зарегистрироваться" Style="{StaticResource RegBtnStyle}" Click="OpenRegWindow"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="35">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Авторизация" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>

                        <TextBlock Text="Чтобы войти, заполните все поля" FontSize="12" Foreground="#250044" TextAlignment="Center" Margin="0,0,0,0"/>

                        <Border Height="1" Margin="0,10" HorizontalAlignment="Stretch">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00250044" Offset="0"/>
                                    <GradientStop Color="#FF250044" Offset="0.5"/>
                                    <GradientStop Color="#FF2e0055" Offset="0.7"/>
                                    <GradientStop Color="#002e0055" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <TextBox Style="{StaticResource TxtBoxStyle}" Tag="Введите логин" x:Name="TBoxLogin" Height="35" Width="300" Margin="0 10 0 15" HorizontalAlignment="Center"/>

                        <TextBox Style="{StaticResource TxtBoxStyle}" Tag="Введите пароль" x:Name="TboxPassword" Height="35" Width="300" Margin="0 10 0 15" HorizontalAlignment="Center"/>

                        <Border Height="1" Margin="0,10" HorizontalAlignment="Stretch">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00250044" Offset="0"/>
                                    <GradientStop Color="#FF250044" Offset="0.5"/>
                                    <GradientStop Color="#FF2e0055" Offset="0.7"/>
                                    <GradientStop Color="#002e0055" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Button Content="Войти" Style="{StaticResource LogBtnStyle}" Click="BtnEnter" Margin="20 10 20 0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
