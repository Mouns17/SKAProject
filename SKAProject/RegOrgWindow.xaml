<Window x:Class="SKAProject.RegOrgWindow" WindowStyle="None" WindowState="Normal" Topmost="True" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" AllowsTransparency="True" Background="Transparent"  
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SKAProject"
        mc:Ignorable="d"
        Height="480" Width="520" FontFamily="Arian">
    <Grid MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
        <Border Width="420" Height="480" CornerRadius="20" BorderThickness="1" BorderBrush="#6366F1" Background="#EDF4FF" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <StackPanel>
                    <Button Content="✖︎" Style="{StaticResource ControlBtnStyle}" Margin="375,5,0,80" Click="BtnClose"/>

                    <TextBlock Text="Регистрация организации" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-60,0,0"/>

                    <TextBlock Text="Чтобы зарегистрировать вашу организацию, заполните все поля" FontSize="12" Foreground="#6366F1" TextAlignment="Center" Margin="0,-25,0,0"/>

                    <Border Height="1" Margin="40 0 40 0" Background="{StaticResource DividerBrush}"/>

                    <TextBox Style="{StaticResource TxtBoxStyle}" Tag="Введите наименование организации" x:Name="TBoxName" Height="35" Width="300" Margin="0 15 0 15" HorizontalAlignment="Center"/>

                    <TextBox Style="{StaticResource TxtBoxStyle}" Tag="Введите адрес организации" x:Name="TBoxAdress" Height="35" Width="300" Margin="0 10 0 15" HorizontalAlignment="Center"/>

                    <TextBox Style="{StaticResource TxtBoxStyle}" Tag="Введите контактный телефон" x:Name="TBoxPhone" Height="35" Width="300" Margin="0 10 0 15" HorizontalAlignment="Center"/>

                    <TextBox Style="{StaticResource TxtBoxStyle}" Tag="Введите адрес эл.почты организации" x:Name="TBoxEmail" Height="35" Width="300" Margin="0 10 0 15" HorizontalAlignment="Center"/>

                    <Border Height="1" Margin="40 0 40 0" Background="{StaticResource DividerBrush}"/>

                    <Button Content="Зарегистрировать организацию" Style="{StaticResource LogBtnStyle}" Click="BtnEnter" Margin="50 15 50 190"/>
                    
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>