<Application
    x:Class="SKAProject.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SKAProject"
    StartupUri="LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <local:StringToAcceptButtonVisibilityConverter x:Key="StringToAcceptButtonVisibilityConverter" />
            <local:StringToRejectButtonVisibilityConverter x:Key="StringToRejectButtonVisibilityConverter" />

            <Viewbox
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                x:Key="LogoIcon"
                Width="120"
                Height="120">
                <Canvas Width="500" Height="500">
                    <!--  Фон  -->
                    <Rectangle
                        Width="500"
                        Height="500"
                        Fill="#6366F1"
                        RadiusX="100"
                        RadiusY="100" />

                    <!--  Центральный элемент: щит  -->
                    <Path
                        Data="M250 60 L380 130 L380 270 Q380 370 250 440 Q120 370 120 270 L120 130 Z"
                        Fill="#FFFFFF"
                        Opacity="0.95" />

                    <!--  Внутренний щит  -->
                    <Path
                        Data="M250 90 L350 145 L350 260 Q350 340 250 390 Q150 340 150 260 L150 145 Z"
                        Fill="Transparent"
                        Stroke="#6366F1"
                        StrokeThickness="8" />

                    <!--  Буквы СКА  -->
                    <TextBlock
                        Canvas.Left="140"
                        Canvas.Top="200"
                        Width="220"
                        FontFamily="Arial"
                        FontSize="80"
                        FontWeight="Bold"
                        Foreground="#6366F1"
                        Text="СКА"
                        TextAlignment="Center" />

                    <!--  Линия под буквами  -->
                    <Line
                        Stroke="#6366F1"
                        StrokeEndLineCap="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="6"
                        X1="170"
                        X2="330"
                        Y1="295"
                        Y2="295" />

                    <!--  График (стилизованный)  -->
                    <Polyline
                        Fill="Transparent"
                        Points="160,340 200,310 240,330 280,280 320,290 340,300"
                        Stroke="#6366F1"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="10" />

                    <!--  Точка на графике  -->
                    <Ellipse
                        Canvas.Left="328"
                        Canvas.Top="288"
                        Width="24"
                        Height="24"
                        Fill="#10B981"
                        Stroke="White"
                        StrokeThickness="4" />
                </Canvas>
            </Viewbox>

            <FontFamily x:Key="Arian">/Fonts/Arian.otf#Arian</FontFamily>
            <FontFamily x:Key="Arian_Bold">/Fonts/Arian-Bold.otf#Arian Bold</FontFamily>

            <Style x:Key="PwdBoxStyle" TargetType="PasswordBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="#6366F1" />
                <Setter Property="BorderThickness" Value="1.4" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#9294f5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Height" Value="35" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#6366F1" />
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="Height" Value="35" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#6366F1" />
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/LightTheme.xaml" />
                <ResourceDictionary Source="Styles/TxtBoxStyle.xaml" />
                <ResourceDictionary Source="Styles/LogBtnStyle.xaml" />
                <ResourceDictionary Source="Styles/RegBtnStyle.xaml" />
                <ResourceDictionary Source="Styles/ExportBtnStyle.xaml" />
                <ResourceDictionary Source="Styles/TaskBtnStyle.xaml" />
                <ResourceDictionary Source="Styles/DeleteBtnStyle.xaml" />
                <ResourceDictionary Source="Styles/ControlBtnStyle.xaml" />
                <ResourceDictionary Source="Styles/ControlBtnStyle2.xaml" />
                <ResourceDictionary Source="Styles/CardStyle.xaml" />
                <ResourceDictionary Source="Styles/MenuBtnStyle.xaml" />
                <ResourceDictionary Source="Styles/RegOrgBtnStyle.xaml" />
                <ResourceDictionary Source="Styles/ModernCardStyle.xaml" />
                <ResourceDictionary Source="Styles/WorkerCardStyle.xaml" />
                <ResourceDictionary Source="Styles/StatusBadgeStyle.xaml" />
                <ResourceDictionary Source="Styles/ThemeToggleButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>