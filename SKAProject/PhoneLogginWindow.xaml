<Window x:Class="SKAProject.PhoneLogginWindow" WindowStyle="ThreeDBorderWindow" WindowState="Maximized" Topmost="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SKAProject"
        mc:Ignorable="d"
        Title="СИСТЕМА КОНТРОЛЯ И АНАЛИЗА | АКАДЕМИК" Height="800" Width="1280">
    <Window.Resources>
        <!-- Набор цветов для градиента -->
        <Color x:Key="Blue1">#163b85</Color>
        <Color x:Key="Blue2">#2f4d97</Color>
        <Color x:Key="Blue3">#4360a8</Color>
        <Color x:Key="Blue4">#5773ba</Color>
        <Color x:Key="Blue5">#6a87cc</Color>
        <Color x:Key="Blue6">#7e9cde</Color>

        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource Blue1}" Offset="0.0"/>
            <GradientStop Color="{StaticResource Blue2}" Offset="0.3"/>
            <GradientStop Color="{StaticResource Blue3}" Offset="0.5"/>
            <GradientStop Color="{StaticResource Blue4}" Offset="0.7"/>
            <GradientStop Color="{StaticResource Blue5}" Offset="0.85"/>
            <GradientStop Color="{StaticResource Blue6}" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Resources>
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Grid.Resources>
            <!-- Стиль для TextBox в виде плашки с изменением обводки при фокусе типа -->
            <Style x:Key="HintTextBox" TargetType="TextBox">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Background" Value="#4360a8"/>
                <Setter Property="BorderBrush" Value="#7e9cde"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">

                            <Grid>
                                <Border x:Name="border" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="10 0"/>
                                <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="White" Margin="22 0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                            <!-- Это вроде фигня чтобы при нажатии на поле ввода исчезал тег -->
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#b8e0d4"/>
                                </Trigger>
                                <!-- А здесь наоборот, если поле для ввода пустое - то показывает тег -->
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Стиль для кнопки входа или регистрации -->
            <Style x:Key="LoginButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#7e9cde"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="FontSize" Value="15"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF"/>
                                </Trigger>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#4360a8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Стиль для кнопок снизу типа -->
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Foreground" Value="#7e9cde"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ControlTemplate.Triggers>
                                <!-- Если юзер навелся на кнопку, то она меняет цвет -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#5773ba"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Foreground" Value="#B39DFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <!-- Цвета фона (Градиент синий) -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource Blue1}" Offset="0.0"/>
                    <GradientStop Color="{StaticResource Blue2}" Offset="0.3"/>
                    <GradientStop Color="{StaticResource Blue3}" Offset="0.5"/>
                    <GradientStop Color="{StaticResource Blue4}" Offset="0.7"/>
                    <GradientStop Color="{StaticResource Blue5}" Offset="0.85"/>
                    <GradientStop Color="{StaticResource Blue6}" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- Вот это типа линия перегородки красивая градиентная -->
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.4" RadiusX="0.8" RadiusY="0.6">
                    <GradientStop Color="#30FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#207A8A7A" Offset="0.4"/>
                    <GradientStop Color="#105A6A5A" Offset="0.7"/>
                    <GradientStop Color="#003A4A3A" Offset="1.0"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="50">
            <Border CornerRadius="40" Background="#D00B0E14" Padding="30" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center" Height="417" Width="500">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" 
                                ShadowDepth="5" 
                                Color="#0c0a0e" 
                                Opacity="0.6"/>
                </Border.Effect>

                <StackPanel Margin="0,13,0,0">
                    <TextBlock Text="АВТОРИЗАЦИЯ" FontSize="28" FontWeight="Bold" Foreground="#FFE8E8E8" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="Чтобы войти, заполните все поля" FontSize="14" Foreground="#7e9cde" HorizontalAlignment="Center" Margin="0 0 0 30"/>

                    <Rectangle Height="1" Margin="0,-8,0,30">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#50FFFFFF" Offset="0.5"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <TextBox Style="{StaticResource HintTextBox}" Tag="Введите номер телефона" x:Name="LoginBox" Height="40" Margin="8 7 8 15"/>

                    <Button Content="Отправить код" Style="{StaticResource LoginButtonStyle}" Click="Login_Click" Margin="20 25 20 0"/>

                    <Rectangle Height="1" Margin="0,30,0,30">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#50FFFFFF" Offset="0.5"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Button Content="Войти по адресу электронной почты" Style="{StaticResource LinkButton}" Margin="110 -10 100 0" Click="OpenEmailAutorization_Click" HorizontalAlignment="Center"/>

                    <Button Content="Назад" Style="{StaticResource LinkButton}" Margin="40 -20 110 0" Click="Back_Click" HorizontalAlignment="Left"/>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
