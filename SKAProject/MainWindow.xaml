<Window
    x:Class="SKAProject.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SKAProject"
    Title="СКА — Система Контроля и Анализа"
    Width="1400"
    Height="800"
    MinWidth="1100"
    MinHeight="700"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Arian"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Window.Resources>
        <!--  Стили кнопок управления окном  -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor1}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="LightSlateGray" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="LightSlateGray" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="CloseButtonStyle"
            BasedOn="{StaticResource WindowControlButton}"
            TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor1}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BF0F1B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Стиль пункта меню (обновлённый)  -->
        <Style x:Key="MenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor1}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Margin="8,1"
                            Padding="18,0"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <!--  полоска слева  -->
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!--  Цветная полоска (скрыта по умолчанию)  -->
                                <Border
                                    x:Name="indicator"
                                    Grid.Column="0"
                                    Width="4"
                                    Height="30"
                                    HorizontalAlignment="Left"
                                    Background="#6366F1"
                                    CornerRadius="2"
                                    Opacity="0" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E7FF" />
                                <Setter TargetName="indicator" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="#6366F1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Стиль заголовка категории (обновлённый)  -->
        <Style x:Key="CategoryHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8899AA" />
            <Setter Property="Margin" Value="18,0,0,6" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource MainBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <!--  шапка  -->
                <RowDefinition Height="*" />
                <!--  контент  -->
            </Grid.RowDefinitions>

            <!--  Кастомная шапка  -->
            <Grid
                Grid.Row="0"
                Background="{DynamicResource TitleBarBackgroundBrush}"
                Effect="{DynamicResource TitleBarShadow}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ForegroundColor1}"
                        Text="СКА — Система Контроля и Анализа" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ToggleButton
                        Margin="0,0,5,0"
                        Checked="ThemeToggle_Checked"
                        IsChecked="False"
                        RenderTransformOrigin="0.5,0.5"
                        Style="{DynamicResource ThemeToggleButtonStyle}"
                        Unchecked="ThemeToggle_Unchecked">
                        <ToggleButton.RenderTransform>
                            <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                        </ToggleButton.RenderTransform>
                    </ToggleButton>
                    <Button
                        Click="MinimizeWindow_Click"
                        Content="&#xE921;"
                        Style="{StaticResource WindowControlButton}" />
                    <Button
                        x:Name="MaxRestoreButton"
                        Click="MaximizeRestoreWindow_Click"
                        Content="&#xE922;"
                        Style="{StaticResource WindowControlButton}" />
                    <Button
                        Click="CloseWindow_Click"
                        Content="&#xE8BB;"
                        Style="{StaticResource CloseButtonStyle}" />
                </StackPanel>
            </Grid>

            <!--  Основной контент: боковое меню + страницы  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <!--  меню  -->
                    <ColumnDefinition Width="*" />
                    <!--  рабочая область  -->
                </Grid.ColumnDefinitions>

                <!--  Боковое меню  -->
                <Border
                    Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BackgroundColor6}"
                    BorderThickness="0,0,1,0"
                    Effect="{DynamicResource SidebarShadow}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,0,0">

                            <!--  === Главное ===  -->
                            <Border
                                Height="1"
                                Margin="15,5,15,10"
                                Background="#E2E8F0" />
                            <TextBlock Style="{StaticResource CategoryHeaderStyle}" Text="Главное" />

                            <Button Click="NavigateToMainMenu" Style="{StaticResource MenuItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontSize="18"
                                        Text="🏠" />
                                    <TextBlock VerticalAlignment="Center" Text="Главное меню" />
                                </StackPanel>
                            </Button>
                            <Button Click="NavigateToMyTasks" Style="{StaticResource MenuItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontSize="18"
                                        Text="📋" />
                                    <TextBlock VerticalAlignment="Center" Text="Мои задачи" />
                                </StackPanel>
                            </Button>
                            <Button Click="NavigateToSendReport" Style="{StaticResource MenuItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontSize="18"
                                        Text="📄" />
                                    <TextBlock VerticalAlignment="Center" Text="Отправить отчёт" />
                                </StackPanel>
                            </Button>
                            <Button Click="NavigateToProfile" Style="{StaticResource MenuItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontSize="18"
                                        Text="👤" />
                                    <TextBlock VerticalAlignment="Center" Text="Профиль" />
                                </StackPanel>
                            </Button>

                            <!--  === Кадры ===  -->
                            <Border
                                Height="1"
                                Margin="15,5,15,10"
                                Background="{DynamicResource BackgroundColor6}"
                                CornerRadius="1" />
                            <TextBlock
                                x:Name="CategoryHR"
                                Style="{StaticResource CategoryHeaderStyle}"
                                Text="Кадры" />

                            <Button
                                x:Name="BtnEmployees"
                                Click="NavigateToWorkers"
                                Style="{StaticResource MenuItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontSize="18"
                                        Text="👥" />
                                    <TextBlock VerticalAlignment="Center" Text="Сотрудники" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="BtnStaffSchedule"
                                Click="NavigateToStaffSchedule"
                                Style="{StaticResource MenuItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontSize="18"
                                        Text="📊" />
                                    <TextBlock VerticalAlignment="Center" Text="Штатное расписание" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="BtnOrders"
                                Click="NavigateToOrders"
                                Style="{StaticResource MenuItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontSize="18"
                                        Text="📝" />
                                    <TextBlock VerticalAlignment="Center" Text="Приказы" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="BtnEmployeeRequests"
                                Click="NavigateToEmployeeRequests"
                                Style="{StaticResource MenuItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontSize="18"
                                        Text="📨" />
                                    <TextBlock VerticalAlignment="Center" Text="Заявки сотрудников" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="BtnEmployeeReports"
                                Click="NavigateToEmployeeReports"
                                Style="{StaticResource MenuItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontSize="18"
                                        Text="📁" />
                                    <TextBlock VerticalAlignment="Center" Text="Отчёты сотрудников" />
                                </StackPanel>
                            </Button>

                            <!--  === Расчёты ===  -->
                            <Border
                                Height="1"
                                Margin="15,5,15,10"
                                Background="{DynamicResource BackgroundColor6}"
                                CornerRadius="1" />
                            <TextBlock
                                x:Name="CategoryPayroll"
                                Style="{StaticResource CategoryHeaderStyle}"
                                Text="Расчёты" />

                            <Button
                                x:Name="BtnSalaries"
                                Click="NavigateToSalaries"
                                Style="{StaticResource MenuItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontSize="18"
                                        Text="💵" />
                                    <TextBlock VerticalAlignment="Center" Text="Оклады и надбавки" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="BtnPayroll"
                                Click="NavigateToPayroll"
                                Style="{StaticResource MenuItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontSize="18"
                                        Text="📠" />
                                    <TextBlock VerticalAlignment="Center" Text="Расчёт зарплаты" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="BtnFinancialReports"
                                Click="NavigateToFinancialReports"
                                Style="{StaticResource MenuItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontSize="18"
                                        Text="📊" />
                                    <TextBlock VerticalAlignment="Center" Text="Финансовые отчёты" />
                                </StackPanel>
                            </Button>

                            <!--  === Администрирование ===  -->
                            <Border
                                Height="1"
                                Margin="15,5,15,10"
                                Background="{DynamicResource BackgroundColor6}"
                                CornerRadius="1" />
                            <TextBlock
                                x:Name="CategoryAdmin"
                                Style="{StaticResource CategoryHeaderStyle}"
                                Text="Администрирование" />

                            <Button
                                x:Name="BtnOrganization"
                                Click="NavigateToOrganization"
                                Style="{StaticResource MenuItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontSize="18"
                                        Text="🏢" />
                                    <TextBlock VerticalAlignment="Center" Text="Моя организация" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="BtnUsers"
                                Click="NavigateToUsers"
                                Style="{StaticResource MenuItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontSize="18"
                                        Text="👤" />
                                    <TextBlock VerticalAlignment="Center" Text="Пользователи" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="BtnLogs"
                                Click="NavigateToLogs"
                                Style="{StaticResource MenuItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontSize="18"
                                        Text="📜" />
                                    <TextBlock VerticalAlignment="Center" Text="Логи системы" />
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!--  Рабочая область – светло-серый фон  -->
                <Border Grid.Column="1" Background="{DynamicResource ContentBackgroundBrush}">
                    <Frame
                        x:Name="MainFrame"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        NavigationUIVisibility="Hidden" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>