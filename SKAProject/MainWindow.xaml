<Window x:Class="SKAProject.MainWindow" WindowStyle="ThreeDBorderWindow" WindowState="Maximized" Topmost="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SKAProject"
        mc:Ignorable="d"
        Title="СИСТЕМА КОНТРОЛЯ И АНАЛИЗА | АКАДЕМИК" Height="1080" Width="1920"
        WindowStartupLocation="CenterScreen"
        Background="#0e1a2b">

    <Window.Resources>

        <SolidColorBrush x:Key="SideBar" Color="#0b1220"/>
        <SolidColorBrush x:Key="Hover" Color="#1e293b"/>
        <SolidColorBrush x:Key="Accent" Color="#3b82f6"/>

        <!-- Стиль для кнопкок (боковых - не названий разделов) -->
        <Style x:Key="MenuBtn" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="10 4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18 0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Hover}"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                </Trigger>

            </Style.Triggers>

            <!-- Стиль для боковых названий разделов -->
        </Style>

        <Style TargetType="TextBlock" x:Key="MenuHeader">
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="20 0 20 8"/>
        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- Боковая менюшка(где кнопки типа) -->
        <Border Background="{StaticResource SideBar}" Grid.Column="0">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock Text="Здесь потом будет логотип"
                               FontSize="26"
                               Foreground="White"
                               Margin="20 30" Width="320"/>


                    <!-- АНАЛИТИКА -->
                    <TextBlock Text="======== АНАЛИТИКА ========" Style="{StaticResource MenuHeader}"/>

                    <Button Style="{StaticResource MenuBtn}" Content="🏠  Главное меню" Click="Home_Click"/>
                    <Button Style="{StaticResource MenuBtn}" Content="📈  Статистика" Click="Stats_Click"/>
                    <Button Style="{StaticResource MenuBtn}" Content="📉  Пересдачи" Click="Retake_Click"/>
                    <Button Style="{StaticResource MenuBtn}" Content="📅  Посещаемость" Click="Attendance_Click"/>


                    <!-- ЛЮДИ -->
                    <TextBlock Text="========== ЛЮДИ ===========" Style="{StaticResource MenuHeader}" Width="314"/>

                    <Button Style="{StaticResource MenuBtn}" Content="🎓  Студенты" Click="Students_Click"/>
                    <Button Style="{StaticResource MenuBtn}" Content="👨‍🏫  Преподаватели" Click="Teachers_Click"/>
                    <Button Style="{StaticResource MenuBtn}" Content="👤  Профиль" Click="Profile_Click"/>


                    <!-- УПРАВЛЕНИЕ -->
                    <TextBlock Text="======== УПРАВЛЕНИЕ ========" Style="{StaticResource MenuHeader}"/>

                    <Button Style="{StaticResource MenuBtn}" Content="🔔  Уведомления" Click="Notify_Click"/>
                    <Button Style="{StaticResource MenuBtn}" Content="🎨  Внешний вид" Click="Theme_Click"/>
                    <Button Style="{StaticResource MenuBtn}" Content="🔐  Аккаунт" Click="Account_Click"/>
                    <Button Style="{StaticResource MenuBtn}" Content="⚙  Настройки" Click="Settings_Click"/>


                    <!-- СИСТЕМА -->
                    <TextBlock Text="========= СИСТЕМА =========" Style="{StaticResource MenuHeader}"/>

                    <Button Style="{StaticResource MenuBtn}" Content="💾  Экспорт данных" Click="Export_Click"/>
                    <Button Style="{StaticResource MenuBtn}" Content="🗂  Логи" Click="Logs_Click"/>
                    <Button Style="{StaticResource MenuBtn}" Content="🚪  Выход" Click="Logout_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  CONTENT (ChatGPT выдал хуй знает зачем пока что)  -->
        <Frame x:Name="MainFrame"
               Grid.Column="1"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>