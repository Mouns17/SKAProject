<Window x:Class="SKAProject.MainWindow" WindowStyle="None" WindowState="Maximized" Topmost="False" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#b7b4e0"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SKAProject"
        mc:Ignorable="d"
        Height="1080" Width="1920" FontFamily="Arian">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="1560"/>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="360 0 -1560 0">
            <Button Content="➖" Style="{StaticResource ControlBtnStyle2}" Margin="1320 10 0 0" Click="BtnRollup"/>

            <Button Content="🔲"  Style="{StaticResource ControlBtnStyle2}" Margin="1405 -35 0 0" Click="BtnMinimize"/>
            
            <Button Content="✖︎" Style="{StaticResource ControlBtnStyle2}" Margin="1490 -35 0 80" Click="BtnClose"/>

            <Border BorderBrush="{StaticResource BackgroundColor6}" BorderThickness="1" Margin="15 -120 150 70" Background="#EDF4FF" CornerRadius="15" Height="40">
                <DockPanel Margin="0 0 0 0">
                    <TextBlock Text="🔍" FontSize="14" DockPanel.Dock="Left" Foreground="#666666" Margin="5 10 0 0"/>
                    <TextBox x:Name="SearchBox2" TextChanged="SearchBox2_TextChanged" Background="Transparent" BorderThickness="0"  Foreground="#010210" FontSize="13" Margin="8,0,0,0" VerticalContentAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Placeholder" Text="Поиск..."  Foreground="#666666" IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Боковая менюшка(где кнопки типа) -->
        <Border Background="{StaticResource BackgroundColor4}" BorderBrush="{StaticResource BackgroundColor6}" BorderThickness="0 0 1 0" Grid.Column="0" Grid.RowSpan="2">
            <StackPanel Margin="0 20 20 20" >

                <Image Source="\Images\Logotype.png" Height="80" Width="115" Margin="0 0 170 0"/>

                <TextBlock Text="СКА" FontSize="40" Foreground="Black" FontFamily="Arian Bold" Margin="60 -80 0 0" Width="100" Height="100"/>

                <TextBlock Text="СИСТЕМА КОНТРОЛЯ И АНАЛИЗА" FontSize="17" Foreground="Black" TextWrapping="Wrap" FontFamily="Arian Bold" Margin="153 -58 0 0" Width="187" Height="100"/>

                <Button Style="{StaticResource MenuBtnStyle}" Content="🏠  Главное меню" Click="Home_Click" Margin="0 -40 0 0"/>

                <Button Style="{StaticResource MenuBtnStyle}" Content="👤  Профиль" Click="Profile_Click" Margin="0 15 0 0"/>

                <Button Style="{StaticResource MenuBtnStyle}" Content="⚙  Настройки" Click="Settings_Click" Margin="0 15 0 0"/>

                <Button Style="{StaticResource MenuBtnStyle}" Content="👥  Список работников" Click="Workers_Click" Margin="0 15 0 0"/>

                <Button Style="{StaticResource MenuBtnStyle}" Content="🏢  Моя организация" Click="MyOrg_Click" Margin="0 15 0 0"/>

                <Button Style="{StaticResource MenuBtnStyle}" Content="📅  Задачи организации" Click="TasksOrg_Click" Margin="0 15 0 0"/>

                <Button Style="{StaticResource MenuBtnStyle}" Content="📅  Мои задачи" Click="MyTasks_Click" Margin="0 15 0 0"/>

                <Button Style="{StaticResource MenuBtnStyle}" Content="📂  Отчеты работников" Click="Otcheti_Click" Margin="0 15 0 0"/>

                <Button Style="{StaticResource MenuBtnStyle}" Content="🗂  Логи" Click="Logs_Click" Margin="0 15 0 0"/>

                <Border CornerRadius="25" BorderBrush="Transparent" Background="{StaticResource BackgroundColor6}" Margin="30 50 30 0" Height="170" Width="280">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" Color="#6366F1" Opacity="1" BlurRadius="15"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Создание организации" FontSize="20" FontFamily="Arian" Foreground="{StaticResource BackgroundColor4}" Margin="35 25 35 0" HorizontalAlignment="Center"/>

                        <TextBlock Text="Для регистрации нажмите на кнопку ниже" TextWrapping="Wrap" FontSize="15" FontFamily="Arian" Foreground="{StaticResource BackgroundColor5}" Margin="35 10 35 0" HorizontalAlignment="Center" />

                        <Button Style="{StaticResource RegOrgBtnStyle}" Content="ЗАРЕГИСТРИРОВАТЬ" Margin="0 20 0 0" Click="BtnRegOrg"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource MenuBtnStyle}" Content="🚪  Выход" Click="Logout_Click" Margin="0 80"/>
            </StackPanel>
        </Border>

        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Grid.RowSpan="2" Navigated="MainFrame_Navigated"/>

    </Grid>
</Window>