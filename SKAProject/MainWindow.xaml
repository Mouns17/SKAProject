<Window x:Class="SKAProject.MainWindow" WindowStyle="None" WindowState="Normal" Topmost="True" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="White"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SKAProject"
        mc:Ignorable="d"
        Title="СИСТЕМА КОНТРОЛЯ И АНАЛИЗА | АКАДЕМИК" Height="1080" Width="1920">

    <Window.Resources>
        <SolidColorBrush x:Key="SideBar" Color="#250044"/>
        <SolidColorBrush x:Key="Hover" Color="#370066"/>
        <SolidColorBrush x:Key="Accent" Color="#3b82f6"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#370066"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <!-- Стиль для кнопкок (боковых - не названий разделов) -->
        <Style x:Key="MenuBtn" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="10 4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18 0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Тригеры для курсора -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Hover}"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>

            <!-- Стиль для боковых названий разделов -->
        </Style>
        <Style TargetType="TextBlock" x:Key="MenuHeader">
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="20 0 20 20"/>
        </Style>
    </Window.Resources>
    <!-- Основная сетка -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="67.5"/>
            <RowDefinition Height="1012.5"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="1560"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая менюшка(где кнопки типа) -->
        <Border CornerRadius="140" Margin="-195,6,35,-154" Background="{StaticResource SideBar}" Grid.Column="0" Grid.Row="1">
            <StackPanel Margin="200 20 0 0" >
                <TextBlock Text="Здесь потом будет логотип" FontSize="20" Foreground="White" Margin="0 0 50 0"/>

                <Button Style="{StaticResource MenuBtn}" Content="🏠  Главное меню" Click="Home_Click"/>

                <Button Style="{StaticResource MenuBtn}" Content="👤  Профиль" Click="Profile_Click"/>

                <Button Style="{StaticResource MenuBtn}" Content="🔐  Аккаунт" Click="Account_Click"/>

                <Button Style="{StaticResource MenuBtn}" Content="⚙  Настройки" Click="Settings_Click"/>

                <Button Style="{StaticResource MenuBtn}" Content="💾  Экспорт данных" Click="Export_Click"/>

                <Button Style="{StaticResource MenuBtn}" Content="🗂  Логи" Click="Logs_Click"/>

                <Button Style="{StaticResource MenuBtn}" Content="🚪  Выход" Click="Logout_Click" Margin="0 450"/>
            </StackPanel>
        </Border>



        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Grid.RowSpan="2"/>

    </Grid>
</Window>