<Window
    x:Class="SKAProject.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SKAProject"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="1920"
    Height="1080"
    Background="{DynamicResource BackgroundColor5}"
    FontFamily="Arian"
    ResizeMode="CanResize"
    Topmost="False"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="1560" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="360,0,-1560,0">
            <Button
                Margin="1320,10,0,0"
                Click="BtnRollup"
                Content="➖"
                Foreground="#010210"
                Style="{DynamicResource ControlBtnStyle2}" />

            <Button
                Margin="1405,-35,0,0"
                Click="BtnMinimize"
                Content="🔲"
                Foreground="#010210"
                Style="{DynamicResource ControlBtnStyle2}" />

            <Button
                Margin="1490,-35,0,80"
                Click="BtnClose"
                Content="✖︎"
                Foreground="#010210"
                Style="{DynamicResource ControlBtnStyle2}" />

            <Border
                Height="40"
                Margin="15,-120,150,70"
                Background="#EDF4FF"
                BorderBrush="{DynamicResource BackgroundColor6}"
                BorderThickness="1"
                CornerRadius="15">
                <DockPanel Margin="0,0,0,0">
                    <TextBlock
                        Margin="5,10,0,0"
                        DockPanel.Dock="Left"
                        FontSize="14"
                        Foreground="#666666"
                        Text="🔍" />
                    <TextBox
                        x:Name="SearchBox2"
                        Margin="8,0,0,0"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        Foreground="#010210"
                        TextChanged="SearchBox2_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                                <TextBlock
                                                    x:Name="Placeholder"
                                                    VerticalAlignment="Center"
                                                    Foreground="#666666"
                                                    IsHitTestVisible="False"
                                                    Text="Поиск..."
                                                    Visibility="Collapsed" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </DockPanel>
            </Border>
        </StackPanel>

        <!--  Боковая менюшка(где кнопки типа)  -->
        <Border
            Grid.RowSpan="2"
            Grid.Column="0"
            Background="{DynamicResource BackgroundColor4}"
            BorderBrush="{DynamicResource BackgroundColor6}"
            BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20,0,20">

                <Image
                    Width="115"
                    Height="80"
                    Margin="0,0,170,0"
                    Source="\Images\Logotype.png" />

                <TextBlock
                    Width="100"
                    Height="100"
                    Margin="60,-80,0,0"
                    FontFamily="Arian Bold"
                    FontSize="40"
                    Foreground="{DynamicResource ForegroundColor1}"
                    Text="СКА" />

                <TextBlock
                    Width="187"
                    Height="100"
                    Margin="153,-58,0,0"
                    FontFamily="Arian Bold"
                    FontSize="17"
                    Foreground="{DynamicResource ForegroundColor1}"
                    Text="СИСТЕМА КОНТРОЛЯ И АНАЛИЗА"
                    TextWrapping="Wrap" />

                <Button
                    Margin="0,-40,20,0"
                    Click="Home_Click"
                    Content="🏠  Главное меню"
                    Style="{DynamicResource MenuBtnStyle}" />

                <Button
                    Margin="0,15,20,0"
                    Click="Profile_Click"
                    Content="👤  Профиль"
                    Style="{DynamicResource MenuBtnStyle}" />

                <Button
                    x:Name="BtnWorkers"
                    Margin="0,15,20,0"
                    Click="Workers_Click"
                    Content="👥  Список работников"
                    Style="{DynamicResource MenuBtnStyle}"
                    Visibility="Visible" />

                <Button
                    x:Name="BtnOrganization"
                    Margin="0,15,20,0"
                    Click="MyOrg_Click"
                    Content="🏢  Моя организация"
                    Style="{DynamicResource MenuBtnStyle}"
                    Visibility="Visible" />

                <Button
                    Margin="0,15,20,0"
                    Click="MyTasks_Click"
                    Content="📅  Мои задачи"
                    Style="{DynamicResource MenuBtnStyle}" />

                <Button
                    x:Name="BtnReports"
                    Margin="0,15,20,0"
                    Click="Otcheti_Click"
                    Content="📂  Отчеты работников"
                    Style="{DynamicResource MenuBtnStyle}"
                    Visibility="Visible" />

                <Button
                    x:Name="BtnLogs"
                    Margin="0,15,20,0"
                    Click="Logs_Click"
                    Content="🗂  Логи"
                    Style="{DynamicResource MenuBtnStyle}"
                    Visibility="Visible" />

                <Separator
                    Width="360"
                    Margin="0,30,0,0"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource ForegroundColor1}" />

                <Border
                    Height="200"
                    Margin="20,30,20,0"
                    Background="{DynamicResource BackgroundColor6}"
                    CornerRadius="15">
                    <Border.BitmapEffect>
                        <DropShadowBitmapEffect
                            Direction="0"
                            ShadowDepth="1"
                            Softness="0.8"
                            Color="Black" />
                    </Border.BitmapEffect>
                    <Grid Margin="20">
                        <Label
                            Margin="0,-12,0,0"
                            HorizontalAlignment="Center"
                            Content="Подписка СКА PRO"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ButtonForeground}" />
                        <TextBlock
                            Margin="5,40,5,0"
                            HorizontalAlignment="Center"
                            FontSize="17"
                            FontWeight="Regular"
                            Foreground="{DynamicResource BackgroundColor1}"
                            Text="Управляйте несколькими организациями и т.д."
                            TextWrapping="Wrap" />
                        <Button
                            Width="200"
                            Margin="0,90,0,0"
                            Click="Button_Click"
                            Content="Подписаться"
                            Style="{DynamicResource RegOrgBtnStyle}" />
                    </Grid>
                </Border>

                <Separator
                    Width="360"
                    Margin="0,30,0,0"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource ForegroundColor1}" />

                <ToggleButton
                    x:Name="ThemeToggleButton"
                    Margin="200,0,0,-350"
                    Checked="ThemeToggleButton_Checked"
                    Style="{DynamicResource ThemeToggleButtonStyle}"
                    Unchecked="ThemeToggleButton_Unchecked" />

                <Button
                    Margin="0,150,140,0"
                    Click="Logout_Click"
                    Content="🚪  Logout"
                    Style="{DynamicResource MenuBtnStyle}" />
            </StackPanel>
        </Border>

        <Frame
            x:Name="MainFrame"
            Grid.RowSpan="2"
            Grid.Column="1"
            Navigated="MainFrame_Navigated"
            NavigationUIVisibility="Hidden" />

    </Grid>
</Window>