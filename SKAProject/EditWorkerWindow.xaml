<Window
    x:Class="SKAProject.EditWorkerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="clr-namespace:SKAProject.Pages"
    Title="Редактирование сотрудника"
    Width="450"
    Height="380"
    Background="#EDF4FF"
    BorderBrush="#6366F1"
    BorderThickness="1"
    FontFamily="Arian"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock
                Margin="0,0,0,15"
                HorizontalAlignment="Center"
                FontSize="22"
                FontWeight="Bold"
                Foreground="#2D3748"
                Text="Редактирование сотрудника" />
            <TextBlock
                x:Name="TxtWorkerName"
                Margin="0,0,0,15"
                HorizontalAlignment="Center"
                FontSize="16"
                Foreground="#4A5568"
                TextWrapping="Wrap" />

            <!--  Отдел  -->
            <TextBlock
                Margin="0,0,0,5"
                FontSize="14"
                Foreground="#4A5568"
                Text="Отдел" />
            <ComboBox
                x:Name="CmbDepartment"
                Height="35"
                FontSize="16"
                ItemsSource="{x:Static pages:WorkersPage.DepartmentsAll}" />

            <!--  Должность  -->
            <TextBlock
                Margin="0,15,0,5"
                FontSize="14"
                Foreground="#4A5568"
                Text="Должность" />
            <ComboBox
                x:Name="CmbPosition"
                Height="35"
                FontSize="16"
                ItemsSource="{x:Static pages:WorkersPage.PositionsAll}" />

            <!--  Статус  -->
            <TextBlock
                Margin="0,15,0,5"
                FontSize="14"
                Foreground="#4A5568"
                Text="Статус" />
            <ComboBox
                x:Name="CmbStatus"
                Height="35"
                FontSize="16"
                ItemsSource="{x:Static pages:WorkersPage.StatusesAll}" />

            <!--  Кнопки  -->
            <StackPanel
                Margin="0,25,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="120"
                    Height="40"
                    Margin="0,0,15,0"
                    Background="#6366F1"
                    BorderThickness="0"
                    Click="BtnSave_Click"
                    Content="Сохранить"
                    Cursor="Hand"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="White" />
                <Button
                    Width="120"
                    Height="40"
                    Background="#A0AEC0"
                    BorderThickness="0"
                    Click="BtnCancel_Click"
                    Content="Отмена"
                    Cursor="Hand"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="White" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>