<Window
    x:Class="SKAProject.AddWorkerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SKAProject"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="420"
    Height="480"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Arian"
    ResizeMode="NoResize"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
        <Border
            Width="420"
            Height="480"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#EDF4FF"
            BorderBrush="#6366F1"
            BorderThickness="1"
            CornerRadius="20">
            <Grid>
                <StackPanel>
                    <Button
                        Margin="375,5,0,80"
                        Click="BtnClose"
                        Content="✖︎"
                        Style="{StaticResource ControlBtnStyle}" />

                    <TextBlock
                        Margin="0,-60,0,0"
                        HorizontalAlignment="Center"
                        FontSize="28"
                        FontWeight="Bold"
                        Text="Добавление сотрудника" />

                    <TextBlock
                        Margin="0,-25,0,0"
                        FontSize="12"
                        Foreground="#6366F1"
                        Text="Чтобы добавить сотрудника, заполните все поля"
                        TextAlignment="Center" />

                    <Border
                        Height="1"
                        Margin="40,0,40,0"
                        Background="{StaticResource DividerBrush}" />

                    <TextBox
                        x:Name="TBoxWorkLastName"
                        Width="300"
                        Height="35"
                        Margin="0,15,0,15"
                        HorizontalAlignment="Center"
                        Style="{StaticResource TxtBoxStyle}"
                        Tag="Введите фамилию"
                        Visibility="Visible" />

                    <TextBox
                        x:Name="TBoxWorkFirstName"
                        Width="300"
                        Height="35"
                        Margin="0,10,0,15"
                        HorizontalAlignment="Center"
                        Style="{StaticResource TxtBoxStyle}"
                        Tag="Введите имя"
                        Visibility="Visible" />

                    <TextBox
                        x:Name="TBoxWorkMiddleName"
                        Width="300"
                        Height="35"
                        Margin="0,10,0,15"
                        HorizontalAlignment="Center"
                        Style="{StaticResource TxtBoxStyle}"
                        Tag="Введите отчество"
                        Visibility="Visible" />

                    <TextBox
                        x:Name="TBoxWorkPhone"
                        Width="300"
                        Height="35"
                        Margin="0,10,0,15"
                        HorizontalAlignment="Center"
                        Style="{StaticResource TxtBoxStyle}"
                        Tag="Введите телефон"
                        Visibility="Visible" />


                    <TextBox
                        x:Name="TBoxWorkEmail"
                        Width="300"
                        Height="35"
                        Margin="0,15,0,15"
                        HorizontalAlignment="Center"
                        Style="{StaticResource TxtBoxStyle}"
                        Tag="Введите email"
                        Visibility="Collapsed" />

                    <TextBox
                        x:Name="TBoxWorkDep"
                        Width="300"
                        Height="35"
                        Margin="0,10,0,15"
                        HorizontalAlignment="Center"
                        Style="{StaticResource TxtBoxStyle}"
                        Tag="Введите отдел"
                        Visibility="Collapsed" />

                    <TextBox
                        x:Name="TBoxWorkPost"
                        Width="300"
                        Height="35"
                        Margin="0,10,0,15"
                        HorizontalAlignment="Center"
                        Style="{StaticResource TxtBoxStyle}"
                        Tag="Введите должность"
                        Visibility="Collapsed" />

                    <TextBox
                        x:Name="TBoxWorkStatus"
                        Width="300"
                        Height="35"
                        Margin="0,10,0,15"
                        HorizontalAlignment="Center"
                        Style="{StaticResource TxtBoxStyle}"
                        Tag="Введите статус"
                        Visibility="Collapsed" />

                    <Border
                        Height="1"
                        Margin="40,0,40,0"
                        Background="{StaticResource DividerBrush}" />

                    <Button
                        x:Name="BtnNextVis"
                        Margin="50,15,50,190"
                        Click="BtnNext"
                        Content="Продолжить &gt; &gt; &gt;"
                        Style="{StaticResource LogBtnStyle}"
                        Visibility="Visible" />

                    <Button
                        x:Name="BtnAddVis"
                        Margin="50,15,50,190"
                        Click="BtnAdd"
                        Content="Добавить"
                        Style="{StaticResource LogBtnStyle}"
                        Visibility="Collapsed" />

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>