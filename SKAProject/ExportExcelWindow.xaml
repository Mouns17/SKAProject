<Window
    x:Class="SKAProject.ExportExcelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420"
    Height="300"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Arian"
    ResizeMode="NoResize"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    WindowStyle="None">
    <Grid MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
        <Border
            Width="420"
            Height="300"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#EDF4FF"
            BorderBrush="#6366F1"
            BorderThickness="1"
            CornerRadius="20">
            <Grid>
                <StackPanel>
                    <Button
                        Margin="375,5,0,80"
                        Click="BtnClose"
                        Content="✖︎"
                        Style="{DynamicResource ControlBtnStyle}" />

                    <TextBlock
                        Margin="0,-60,0,0"
                        HorizontalAlignment="Center"
                        FontSize="28"
                        FontWeight="Bold"
                        Text="Экспорт в Excel" />

                    <TextBlock
                        Margin="0,-25,0,0"
                        FontSize="12"
                        Foreground="#6366F1"
                        Text="Выберите путь для сохранения файла"
                        TextAlignment="Center" />

                    <Border
                        Height="1"
                        Margin="40,0,40,0"
                        Background="{DynamicResource DividerBrush}" />

                    <!--  Путь к файлу  -->
                    <StackPanel Margin="0,15,0,10">
                        <TextBlock
                            Margin="60,0,0,5"
                            HorizontalAlignment="Left"
                            FontSize="14"
                            Foreground="#4A5568"
                            Text="Путь сохранения:" />
                        <Grid>
                            <TextBox
                                x:Name="TBoxPath"
                                Width="240"
                                Height="35"
                                Margin="50,0,0,0"
                                HorizontalAlignment="Left"
                                Style="{DynamicResource TxtBoxStyle}"
                                Tag="Выберите файл" />
                            <Button
                                x:Name="BtnBrowse"
                                Width="60"
                                Height="35"
                                Margin="300,0,0,0"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderBrush="#6366F1"
                                BorderThickness="1.5"
                                Click="BtnBrowse_Click"
                                Content="📂"
                                Cursor="Hand"
                                FontSize="18"
                                Style="{DynamicResource ControlBtnStyle}" />
                        </Grid>
                    </StackPanel>

                    <Border
                        Height="1"
                        Margin="40,0,40,10"
                        Background="{DynamicResource DividerBrush}" />

                    <Button
                        x:Name="BtnExport"
                        Margin="100,15,100,190"
                        Click="BtnExport_Click"
                        Content="Экспорт"
                        Style="{DynamicResource LogBtnStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>